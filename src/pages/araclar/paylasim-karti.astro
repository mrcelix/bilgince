---
import Base from '../../layouts/Base.astro';

const stiller = [
  { id: 'site', ad: 'Site teması', ikon: '🎯', kart: 'linear-gradient(140deg,#3a45e0,#7b3fd4)' },
  { id: 'neon', ad: 'Neon Cyber', ikon: '🌃', kart: 'linear-gradient(140deg,#a855f7,#6366f1)' },
  { id: 'doga', ad: 'Doğa', ikon: '🌿', kart: 'linear-gradient(140deg,#34d399,#4ade80)' },
  { id: 'okyanus', ad: 'Okyanus', ikon: '🌊', kart: 'linear-gradient(140deg,#38bdf8,#3b82f6)' },
  { id: 'altin', ad: 'Lüks Altın', ikon: '✨', kart: 'linear-gradient(140deg,#fbbf24,#f59e0b)' },
  { id: 'piksel', ad: 'Retro Piksel', ikon: '🎮', kart: 'linear-gradient(140deg,#fb7185,#f472b6)' },
  { id: 'suluboya', ad: 'Suluboya', ikon: '🎨', kart: 'linear-gradient(140deg,#e9d5ff,#fbcfe8)' },
  { id: 'steampunk', ad: 'Steampunk', ikon: '⚙️', kart: 'linear-gradient(140deg,#a67c52,#6b5136)' },
  { id: 'galaksi', ad: 'Galaksi', ikon: '🌌', kart: 'linear-gradient(140deg,#8b5cf6,#4c1d95)' },
  { id: 'anime', ad: 'Anime', ikon: '🍃', kart: 'linear-gradient(140deg,#fda4af,#a5b4fc)' },
  { id: 'minimal', ad: 'Minimal', ikon: '⚪', kart: 'linear-gradient(140deg,#f1f5f9,#e2e8f0)' },
  { id: 'ates', ad: 'Ateş', ikon: '🔥', kart: 'linear-gradient(140deg,#fb923c,#ef4444)' },
  { id: 'kristal', ad: 'Kristal', ikon: '💎', kart: 'linear-gradient(140deg,#67e8f9,#818cf8)' },
];

const boyutlar = [
  { id: 'manset', ad: 'Manşet', olcu: '1200 × 630', not: 'X, LinkedIn, OG' },
  { id: 'kare', ad: 'Kare', olcu: '1080 × 1080', not: 'Instagram, LinkedIn' },
  { id: 'portre', ad: 'Portre', olcu: '1080 × 1350', not: 'Instagram' },
  { id: 'hikaye', ad: 'Hikâye', olcu: '1080 × 1920', not: 'Story, Reels' },
];
---

<Base
  baslik="Paylaşım kartı üreteci"
  aciklama="Bir site adresi girin; sitenin kendi renk temasını okuyup sosyal medya için hazır paylaşım görselleri ve metinleri üretsin. 13 farklı stille yeniden üretilebilir."
  aramaya={false}
>
  <div class="arama-bas">
    <div class="kap">
      <nav class="kirinti" aria-label="Kırıntı yolu" style="padding-top:0">
        <a href="/">Ana sayfa</a><span class="ayrac">/</span><span aria-current="page"
          >Paylaşım kartı üreteci</span
        >
      </nav>
      <h1>Paylaşım kartı üreteci</h1>
      <p style="color:var(--muted);font-size:14px;margin-top:8px;max-width:62ch">
        Adresi girin: sayfanın başlığı, açıklaması ve <strong>gerçek CSS renkleri</strong> okunur, ondan
        bir paylaşım kartı çizilir. Sonra aynı içeriği 12 hazır stille yeniden üretebilirsiniz. Her şey
        tarayıcınızda çizilir; PNG olarak iner.
      </p>
    </div>
  </div>

  <div class="kap pk">
    <!-- 1. Adres -->
    <section class="pk-blok">
      <h2 class="pk-h2"><span class="pk-no">1</span> Site adresi</h2>
      <form id="pk-form" class="pk-form">
        <input
          id="pk-adres"
          type="url"
          inputmode="url"
          placeholder="https://ornek.com"
          required
          aria-label="Analiz edilecek site adresi"
        />
        <button type="submit" class="dg" id="pk-btn">Analiz et</button>
      </form>
      <p id="pk-durum" class="pk-durum" role="status" aria-live="polite"></p>
      <div id="pk-tema" class="pk-tema" hidden>
        <span class="pk-tema-ad"></span>
        <span class="pk-swatch-grup"></span>
      </div>
    </section>

    <!-- 2. İçerik -->
    <section class="pk-blok" id="pk-icerik-blok" hidden>
      <h2 class="pk-h2"><span class="pk-no">2</span> Kart içeriği</h2>
      <div class="pk-alanlar">
        <label>Üst etiket<input id="pk-rozet" type="text" maxlength="40" /></label>
        <label>Başlık<textarea id="pk-baslik" rows="2" maxlength="140"></textarea></label>
        <label>Alt metin<textarea id="pk-ozet" rows="2" maxlength="200"></textarea></label>
      </div>
    </section>

    <!-- 3. Stil -->
    <section class="pk-blok" id="pk-stil-blok" hidden>
      <h2 class="pk-h2"><span class="pk-no">3</span> Stil galerisi</h2>
      <div class="pk-galeri" role="radiogroup" aria-label="Kart stili">
        {
          stiller.map((s, i) => (
            <button
              type="button"
              class="pk-stil"
              role="radio"
              aria-checked={i === 0 ? 'true' : 'false'}
              data-stil={s.id}
              style={`--kart:${s.kart}`}
            >
              <span class="pk-stil-ikon" aria-hidden="true">
                {s.ikon}
              </span>
              <span class="pk-stil-ad">{s.ad}</span>
            </button>
          ))
        }
      </div>
    </section>

    <!-- 4. Önizleme -->
    <section class="pk-blok" id="pk-onizleme-blok" hidden>
      <h2 class="pk-h2"><span class="pk-no">4</span> Önizleme ve indirme</h2>
      <div class="pk-boyutlar" role="radiogroup" aria-label="Görsel boyutu">
        {
          boyutlar.map((b, i) => (
            <button
              type="button"
              class="pk-boyut"
              role="radio"
              aria-checked={i === 0 ? 'true' : 'false'}
              data-boyut={b.id}
            >
              <strong>{b.ad}</strong>
              <span>{b.olcu}</span>
              <em>{b.not}</em>
            </button>
          ))
        }
      </div>

      <div class="pk-tuval-kutu">
        <canvas id="pk-tuval" width="1200" height="630"></canvas>
      </div>

      <div class="pk-eylem">
        <button type="button" class="dg" id="pk-indir">PNG indir</button>
        <button type="button" class="dg dg-ikincil" id="pk-tumu">Dört boyutu da indir</button>
        <button type="button" class="dg dg-ai" id="pk-ai">✨ AI arka plan üret</button>
        <button type="button" class="dg dg-ikincil" id="pk-ai-sil" hidden>AI arka planı kaldır</button>
      </div>
      <p id="pk-ai-durum" class="pk-durum" role="status" aria-live="polite"></p>
    </section>

    <!-- 5. Metinler -->
    <section class="pk-blok" id="pk-metin-blok" hidden>
      <h2 class="pk-h2"><span class="pk-no">5</span> Paylaşım metinleri</h2>
      <div class="pk-metinler" id="pk-metinler"></div>
    </section>
  </div>

  <script is:inline>
    (() => {
      /* ==================================================================
         Stil tanımları — her biri zemin, desen ve tipografi kararı taşır
         ================================================================== */
      const STIL = {
        neon: { zemin: ['#0b1026', '#2b0f4d', '#0b1026'], ink: '#f4f6ff', alt: '#a5b4fc', vurgu: '#22d3ee', desen: 'izgara', parlak: true },
        doga: { zemin: ['#0f3d2e', '#1f7a4c', '#3fae62'], ink: '#f2fff7', alt: '#bbf7d0', vurgu: '#fde68a', desen: 'yaprak' },
        okyanus: { zemin: ['#062a52', '#0b62a4', '#1ba0d8'], ink: '#f0faff', alt: '#bae6fd', vurgu: '#fbbf24', desen: 'dalga' },
        altin: { zemin: ['#1a1408', '#3d2f10', '#12100a'], ink: '#fdf6e3', alt: '#e6c169', vurgu: '#f3c65a', desen: 'ışık', serif: true },
        piksel: { zemin: ['#241b3a', '#3b2a63', '#241b3a'], ink: '#fff7fb', alt: '#f9a8d4', vurgu: '#4ade80', desen: 'piksel', kare: true },
        suluboya: { zemin: ['#fdf3ff', '#eef2ff', '#fff1f5'], ink: '#3b2f4a', alt: '#7c6f8f', vurgu: '#c084fc', desen: 'leke' },
        steampunk: { zemin: ['#2b1f14', '#4a3620', '#1c140d'], ink: '#f5e9d7', alt: '#c9a87c', vurgu: '#d98b3a', desen: 'disli', serif: true },
        galaksi: { zemin: ['#0a0620', '#2e1065', '#4c1d95'], ink: '#f5f3ff', alt: '#c4b5fd', vurgu: '#f0abfc', desen: 'yildiz' },
        anime: { zemin: ['#fee2e8', '#e0e7ff', '#cffafe'], ink: '#1f2a44', alt: '#4c5b7d', vurgu: '#f43f5e', desen: 'hiz' },
        minimal: { zemin: ['#ffffff', '#f6f7f9'], ink: '#111827', alt: '#6b7280', vurgu: '#111827', desen: 'cizgi' },
        ates: { zemin: ['#2a0a05', '#7c2d12', '#ea580c'], ink: '#fff7ed', alt: '#fed7aa', vurgu: '#fde047', desen: 'kor' },
        kristal: { zemin: ['#062b3a', '#0e5b7a', '#38bdf8'], ink: '#f0fdff', alt: '#a5f3fc', vurgu: '#e0e7ff', desen: 'faset' },
      };

      const BOYUT = {
        manset: [1200, 630],
        kare: [1080, 1080],
        portre: [1080, 1350],
        hikaye: [1080, 1920],
      };

      const el = (s) => document.querySelector(s);
      const tuval = el('#pk-tuval');
      const ctx = tuval.getContext('2d');

      let veri = null;
      let stilId = 'site';
      let boyutId = 'manset';
      let aiGorsel = null; // yüklendiğinde prosedürel zemin yerine bu kullanılır
      let aiStil = null;

      /* ==================================================================
         Yardımcılar
         ================================================================== */

      // Aynı site her zaman aynı deseni üretsin diye tohumlu üreteç
      function uretec(tohum) {
        let t = 0;
        for (let i = 0; i < tohum.length; i++) t = (t * 31 + tohum.charCodeAt(i)) >>> 0;
        return () => {
          t += 0x6d2b79f5;
          let x = t;
          x = Math.imul(x ^ (x >>> 15), x | 1);
          x ^= x + Math.imul(x ^ (x >>> 7), x | 61);
          return ((x ^ (x >>> 14)) >>> 0) / 4294967296;
        };
      }

      function hexHsl(hex) {
        const n = parseInt(hex.slice(1), 16);
        const [r, g, b] = [(n >> 16) & 255, (n >> 8) & 255, n & 255].map((k) => k / 255);
        const enB = Math.max(r, g, b);
        const enK = Math.min(r, g, b);
        const l = (enB + enK) / 2;
        const d = enB - enK;
        if (!d) return { h: 0, s: 0, l };
        const s = l > 0.5 ? d / (2 - enB - enK) : d / (enB + enK);
        const h = (enB === r ? (g - b) / d + (g < b ? 6 : 0) : enB === g ? (b - r) / d + 2 : (r - g) / d + 4) / 6;
        return { h: h * 360, s, l };
      }

      function hslHex({ h, s, l }) {
        const c = (1 - Math.abs(2 * l - 1)) * s;
        const x = c * (1 - Math.abs(((h / 60) % 2) - 1));
        const m = l - c / 2;
        const d = Math.floor(h / 60) % 6;
        const [r, g, b] = [
          [c, x, 0], [x, c, 0], [0, c, x], [0, x, c], [x, 0, c], [c, 0, x],
        ][d < 0 ? d + 6 : d];
        return (
          '#' +
          [r, g, b].map((k) => Math.round((k + m) * 255).toString(16).padStart(2, '0')).join('')
        );
      }

      /** Tonu koruyarak parlaklığı sabitler; en az `enAzDoygunluk` doygunluk garanti eder. */
      function tonla(hex, l, enAzDoygunluk = 0.42) {
        const c = hexHsl(hex);
        return hslHex({ h: c.h, s: Math.max(c.s, enAzDoygunluk), l });
      }

      function parlaklik(hex) {
        const n = parseInt(hex.slice(1), 16);
        return (0.299 * ((n >> 16) & 255) + 0.587 * ((n >> 8) & 255) + 0.114 * (n & 255)) / 255;
      }

      /**
       * Analiz sonucundan "site teması" stilini kurar.
       * Parlaklıklar sabit tutulur; yalnızca ton sitenin kendisinden gelir.
       * Böylece koyu paletli bir site de okunaklı bir kart üretir.
       */
      function siteStili(p) {
        const v = p.vurgu;
        const v2 = hexHsl(p.vurgu2).s > 0.2 ? p.vurgu2 : p.vurgu;
        return {
          zemin: [tonla(v, 0.16), tonla(v, 0.38), tonla(v2, 0.5)],
          ink: '#ffffff',
          alt: tonla(v, 0.84, 0.5),
          vurgu: tonla(v2, 0.64, 0.6),
          desen: 'izgara',
        };
      }

      function aktifStil() {
        return stilId === 'site' && veri ? siteStili(veri.palet) : STIL[stilId] || STIL.minimal;
      }

      function sarmala(metin, enBoy, satirSiniri) {
        const kelimeler = String(metin).split(/\s+/).filter(Boolean);
        const satirlar = [];
        let su = '';
        for (const k of kelimeler) {
          const deneme = su ? su + ' ' + k : k;
          if (ctx.measureText(deneme).width > enBoy && su) {
            satirlar.push(su);
            su = k;
            if (satirlar.length === satirSiniri) break;
          } else {
            su = deneme;
          }
        }
        if (satirlar.length < satirSiniri && su) satirlar.push(su);
        if (satirlar.length === satirSiniri) {
          // son satır sığmıyorsa üç nokta ile kes
          let son = satirlar[satirSiniri - 1];
          if (kelimeler.join(' ').length > satirlar.join(' ').length) {
            while (son.length > 4 && ctx.measureText(son + '…').width > enBoy) son = son.slice(0, -1);
            satirlar[satirSiniri - 1] = son + '…';
          }
        }
        return satirlar;
      }

      /* ==================================================================
         Desenler
         ================================================================== */

      function desenCiz(ad, w, h, s, rnd) {
        ctx.save();
        switch (ad) {
          case 'izgara': {
            ctx.strokeStyle = s.vurgu;
            ctx.globalAlpha = 0.14;
            ctx.lineWidth = Math.max(1, w / 900);
            const adim = w / 16;
            for (let x = 0; x <= w; x += adim) {
              ctx.beginPath();
              ctx.moveTo(x, 0);
              ctx.lineTo(x, h);
              ctx.stroke();
            }
            for (let y = 0; y <= h; y += adim) {
              ctx.beginPath();
              ctx.moveTo(0, y);
              ctx.lineTo(w, y);
              ctx.stroke();
            }
            ctx.globalAlpha = 0.5;
            for (let i = 0; i < 3; i++) {
              const g = ctx.createRadialGradient(rnd() * w, rnd() * h * 0.7, 0, rnd() * w, rnd() * h, w * 0.45);
              g.addColorStop(0, s.vurgu + '55');
              g.addColorStop(1, 'transparent');
              ctx.fillStyle = g;
              ctx.fillRect(0, 0, w, h);
            }
            break;
          }
          case 'dalga': {
            ctx.globalAlpha = 0.2;
            ctx.lineWidth = w / 300;
            ctx.strokeStyle = '#ffffff';
            for (let i = 0; i < 6; i++) {
              const taban = h * (0.28 + i * 0.13);
              const genlik = h * 0.045 * (1 + rnd());
              ctx.beginPath();
              for (let x = 0; x <= w; x += 8) {
                const y = taban + Math.sin((x / w) * Math.PI * 3 + i) * genlik;
                x === 0 ? ctx.moveTo(x, y) : ctx.lineTo(x, y);
              }
              ctx.stroke();
            }
            break;
          }
          case 'yaprak': {
            ctx.globalAlpha = 0.16;
            for (let i = 0; i < 16; i++) {
              const cx = rnd() * w;
              const cy = rnd() * h;
              const r = w * (0.04 + rnd() * 0.09);
              ctx.fillStyle = i % 3 === 0 ? s.vurgu : '#ffffff';
              ctx.beginPath();
              ctx.ellipse(cx, cy, r, r * 0.5, rnd() * Math.PI, 0, Math.PI * 2);
              ctx.fill();
            }
            break;
          }
          case 'ışık': {
            ctx.globalAlpha = 0.16;
            ctx.strokeStyle = s.vurgu;
            ctx.lineWidth = w / 90;
            for (let i = -2; i < 14; i++) {
              const x = (i * w) / 9;
              ctx.beginPath();
              ctx.moveTo(x, -h * 0.1);
              ctx.lineTo(x + w * 0.3, h * 1.1);
              ctx.stroke();
            }
            break;
          }
          case 'piksel': {
            const k = w / 30;
            ctx.globalAlpha = 0.25;
            for (let i = 0; i < 90; i++) {
              ctx.fillStyle = [s.vurgu, s.alt, '#ffffff'][Math.floor(rnd() * 3)];
              ctx.fillRect(Math.floor((rnd() * w) / k) * k, Math.floor((rnd() * h) / k) * k, k, k);
            }
            break;
          }
          case 'leke': {
            ctx.globalAlpha = 0.5;
            for (let i = 0; i < 9; i++) {
              const cx = rnd() * w;
              const cy = rnd() * h;
              const r = w * (0.12 + rnd() * 0.22);
              const g = ctx.createRadialGradient(cx, cy, 0, cx, cy, r);
              g.addColorStop(0, ['#c084fc55', '#f9a8d455', '#93c5fd55', '#fcd34d55'][i % 4]);
              g.addColorStop(1, 'transparent');
              ctx.fillStyle = g;
              ctx.beginPath();
              ctx.arc(cx, cy, r, 0, Math.PI * 2);
              ctx.fill();
            }
            break;
          }
          case 'disli': {
            ctx.globalAlpha = 0.18;
            ctx.strokeStyle = s.vurgu;
            ctx.lineWidth = w / 220;
            for (let i = 0; i < 4; i++) {
              const cx = rnd() * w;
              const cy = rnd() * h;
              const r = w * (0.07 + rnd() * 0.11);
              for (const ölçek of [1, 0.72, 0.44]) {
                ctx.beginPath();
                ctx.arc(cx, cy, r * ölçek, 0, Math.PI * 2);
                ctx.stroke();
              }
              for (let d = 0; d < 12; d++) {
                const a = (d / 12) * Math.PI * 2;
                ctx.beginPath();
                ctx.moveTo(cx + Math.cos(a) * r, cy + Math.sin(a) * r);
                ctx.lineTo(cx + Math.cos(a) * r * 1.16, cy + Math.sin(a) * r * 1.16);
                ctx.stroke();
              }
            }
            break;
          }
          case 'yildiz': {
            for (let i = 0; i < 160; i++) {
              ctx.globalAlpha = 0.25 + rnd() * 0.75;
              ctx.fillStyle = i % 9 === 0 ? s.vurgu : '#ffffff';
              const r = (w / 1400) * (1 + rnd() * 2.4);
              ctx.beginPath();
              ctx.arc(rnd() * w, rnd() * h, r, 0, Math.PI * 2);
              ctx.fill();
            }
            ctx.globalAlpha = 0.55;
            const neb = ctx.createRadialGradient(w * 0.75, h * 0.28, 0, w * 0.75, h * 0.28, w * 0.5);
            neb.addColorStop(0, '#f0abfc44');
            neb.addColorStop(1, 'transparent');
            ctx.fillStyle = neb;
            ctx.fillRect(0, 0, w, h);
            break;
          }
          case 'hiz': {
            ctx.globalAlpha = 0.22;
            ctx.strokeStyle = '#ffffff';
            const mx = w * 0.82;
            const my = h * 0.2;
            for (let i = 0; i < 40; i++) {
              const a = rnd() * Math.PI * 2;
              const i0 = w * (0.16 + rnd() * 0.1);
              const i1 = i0 + w * (0.1 + rnd() * 0.3);
              ctx.lineWidth = w / 800 + rnd() * (w / 400);
              ctx.beginPath();
              ctx.moveTo(mx + Math.cos(a) * i0, my + Math.sin(a) * i0);
              ctx.lineTo(mx + Math.cos(a) * i1, my + Math.sin(a) * i1);
              ctx.stroke();
            }
            break;
          }
          case 'cizgi': {
            ctx.globalAlpha = 1;
            ctx.strokeStyle = '#e5e7eb';
            ctx.lineWidth = w / 900;
            ctx.beginPath();
            ctx.moveTo(w * 0.08, h * 0.18);
            ctx.lineTo(w * 0.92, h * 0.18);
            ctx.stroke();
            break;
          }
          case 'kor': {
            ctx.globalAlpha = 0.6;
            for (let i = 0; i < 70; i++) {
              const y = h * (0.35 + rnd() * 0.65);
              const r = (w / 700) * (1 + rnd() * 3);
              ctx.fillStyle = ['#fde047', '#fb923c', '#ffffff'][Math.floor(rnd() * 3)];
              ctx.globalAlpha = 0.2 + rnd() * 0.6;
              ctx.beginPath();
              ctx.arc(rnd() * w, y, r, 0, Math.PI * 2);
              ctx.fill();
            }
            break;
          }
          case 'faset': {
            ctx.globalAlpha = 0.14;
            for (let i = 0; i < 22; i++) {
              ctx.fillStyle = i % 2 ? '#ffffff' : s.vurgu;
              ctx.beginPath();
              const cx = rnd() * w;
              const cy = rnd() * h;
              const r = w * (0.05 + rnd() * 0.13);
              for (let k = 0; k < 5; k++) {
                const a = (k / 5) * Math.PI * 2 + rnd() * 0.4;
                const p = r * (0.6 + rnd() * 0.6);
                k === 0
                  ? ctx.moveTo(cx + Math.cos(a) * p, cy + Math.sin(a) * p)
                  : ctx.lineTo(cx + Math.cos(a) * p, cy + Math.sin(a) * p);
              }
              ctx.closePath();
              ctx.fill();
            }
            break;
          }
        }
        ctx.restore();
      }

      /* ==================================================================
         Kart çizimi
         ================================================================== */

      function ciz() {
        if (!veri) return;
        const [w, h] = BOYUT[boyutId];
        tuval.width = w;
        tuval.height = h;
        const s = aktifStil();
        const rnd = uretec(veri.alan + stilId);
        const u = Math.sqrt((w * h) / (1200 * 630));
        const pad = w * 0.078;
        const yazi = s.serif ? 'Georgia, "Times New Roman", serif' : 'Nunito, system-ui, sans-serif';

        const acikMetin = parlaklik(s.ink) > 0.5;
        const aiVar = aiGorsel && aiStil === stilId;

        /* --- Düzen, çizimden önce hesaplanır -------------------------------
           Perde sabit bir orana değil metnin gerçek üst sınırına dayanmalı:
           AI görselleri kalabalık olabiliyor ve parlak bir leke tam başlığın
           arkasına denk gelirse metin okunmaz oluyor. */
        const icBoy = w - pad * 2;
        const baslikPx = (boyutId === 'manset' ? 62 : 66) * u;
        const bSat = baslikPx * 1.16;
        const oSat = 26 * u * 1.45;
        const altBar = 60 * u;
        const bosluk = 22 * u;

        ctx.font = `900 ${baslikPx}px ${yazi}`;
        let bSatir = sarmala(el('#pk-baslik').value || veri.baslik, icBoy, boyutId === 'manset' ? 3 : 4);
        ctx.font = `500 ${26 * u}px ${yazi}`;
        let oSatir = el('#pk-ozet').value ? sarmala(el('#pk-ozet').value, icBoy, 3) : [];

        // Rozetin altından alt çubuğa kadar olan alana sığmalı; sığmıyorsa önce
        // özet satırları, sonra başlık satırları kısalır. Böylece uzun başlıklı
        // sitelerde metin rozetin üstüne binmez.
        const tavan = pad + 44 * u + 30 * u;
        const yer = h - pad - altBar - tavan;
        const gerek = () => bSatir.length * bSat + (oSatir.length ? oSatir.length * oSat + bosluk : 0);
        while (gerek() > yer && oSatir.length > 0) oSatir = oSatir.slice(0, -1);
        while (gerek() > yer && bSatir.length > 1) bSatir = bSatir.slice(0, -1);

        const metinUst = h - pad - altBar - (oSatir.length ? oSatir.length * oSat + bosluk : 0) - bSatir.length * bSat;

        /* --- Zemin --------------------------------------------------------- */
        if (aiVar) {
          // kırpmadan doldur (cover): oran farkını merkezden kes
          const olcek = Math.max(w / aiGorsel.naturalWidth, h / aiGorsel.naturalHeight);
          const gw = aiGorsel.naturalWidth * olcek;
          const gh = aiGorsel.naturalHeight * olcek;
          ctx.drawImage(aiGorsel, (w - gw) / 2, (h - gh) / 2, gw, gh);
        } else {
          const g = ctx.createLinearGradient(0, 0, w * 0.85, h);
          s.zemin.forEach((c, i) => g.addColorStop(i / (s.zemin.length - 1), c));
          ctx.fillStyle = g;
          ctx.fillRect(0, 0, w, h);
          desenCiz(s.desen, w, h, s, rnd);
        }

        /* --- Okunabilirlik perdesi ------------------------------------------ */
        const perdeBas = aiVar ? Math.max(0, metinUst - h * 0.12) : h * 0.28;
        const perde = ctx.createLinearGradient(0, perdeBas, 0, h);
        perde.addColorStop(0, 'transparent');
        if (aiVar) {
          // Durak konumu piksele göre hesaplanır: perde, metnin başladığı satırda
          // tam gücüne ulaşmalı. Oransal durak kullanınca başlığın ilk satırı
          // perdenin daha şeffaf olduğu bölgeye denk geliyordu.
          const f = Math.min(1, Math.max(0, (metinUst - perdeBas) / (h - perdeBas)));
          const ort = acikMetin ? 'rgba(0,0,0,0.78)' : 'rgba(255,255,255,0.88)';
          perde.addColorStop(f, ort);
          perde.addColorStop(1, acikMetin ? 'rgba(0,0,0,0.9)' : 'rgba(255,255,255,0.95)');
        } else {
          perde.addColorStop(1, acikMetin ? 'rgba(0,0,0,0.55)' : 'rgba(255,255,255,0.72)');
        }
        ctx.fillStyle = perde;
        ctx.fillRect(0, 0, w, h);

        /* --- Üst rozet ------------------------------------------------------ */
        const rozet = (el('#pk-rozet').value || veri.alan).toLocaleUpperCase('tr');
        ctx.font = `800 ${22 * u}px ${yazi}`;
        ctx.textBaseline = 'middle';
        const rw = ctx.measureText(rozet).width + 34 * u;
        const rh = 44 * u;
        ctx.fillStyle = s.vurgu;
        if (s.kare) ctx.fillRect(pad, pad, rw, rh);
        else {
          ctx.beginPath();
          ctx.roundRect(pad, pad, rw, rh, rh / 2);
          ctx.fill();
        }
        ctx.fillStyle = parlaklik(s.vurgu) > 0.6 ? '#111827' : '#ffffff';
        ctx.letterSpacing = `${1.4 * u}px`;
        ctx.fillText(rozet, pad + 17 * u, pad + rh / 2 + u);
        ctx.letterSpacing = '0px';

        let y = metinUst;

        // AI zemininde metin, arkasındaki lekeden bağımsız okunmalı: metin
        // rengiyle zıt bir hale, perdeyi ağırlaştırmadan kontrastı garantiler.
        const haleAc = () => {
          if (aiVar) {
            ctx.shadowColor = acikMetin ? 'rgba(0,0,0,0.92)' : 'rgba(255,255,255,0.92)';
            ctx.shadowBlur = 16 * u;
          } else if (s.parlak) {
            ctx.shadowColor = s.vurgu;
            ctx.shadowBlur = 26 * u;
          }
        };
        haleAc();
        ctx.font = `900 ${baslikPx}px ${yazi}`;
        ctx.fillStyle = s.ink;
        ctx.textBaseline = 'top';
        for (const satir of bSatir) {
          ctx.fillText(satir, pad, y);
          y += bSat;
        }
        ctx.shadowBlur = 0;

        if (oSatir.length) {
          y += bosluk;
          haleAc();
          ctx.font = `500 ${26 * u}px ${yazi}`;
          ctx.fillStyle = aiVar ? s.ink : s.alt;
          for (const satir of oSatir) {
            ctx.fillText(satir, pad, y);
            y += oSat;
          }
          ctx.shadowBlur = 0;
        }

        // alt çubuk: vurgu şeridi + alan adı
        const barY = h - pad - 26 * u;
        ctx.fillStyle = s.vurgu;
        ctx.fillRect(pad, barY - 16 * u, 64 * u, 6 * u);
        haleAc();
        ctx.font = `700 ${24 * u}px ${yazi}`;
        ctx.fillStyle = aiVar ? s.ink : s.alt;
        ctx.textBaseline = 'middle';
        ctx.fillText(veri.alan, pad + 80 * u, barY - 12 * u);
        ctx.shadowBlur = 0;
      }

      /* ==================================================================
         Paylaşım metinleri
         ================================================================== */

      function etiketUret() {
        const durak = new Set(['için', 'ile', 'and', 'the', 'bir', 'daha', 'nasıl', 'olarak', 've']);
        return (veri.baslik + ' ' + veri.aciklama)
          .toLocaleLowerCase('tr')
          .replace(/[^\p{L}\p{N}\s]/gu, ' ')
          .split(/\s+/)
          .filter((k) => k.length > 3 && !durak.has(k))
          .slice(0, 3)
          .map((k) => '#' + k.replace(/[ıİ]/g, 'i').replace(/ğ/g, 'g').replace(/ü/g, 'u').replace(/ş/g, 's').replace(/ö/g, 'o').replace(/ç/g, 'c'))
          .join(' ');
      }

      function metinleriYaz() {
        const b = el('#pk-baslik').value || veri.baslik;
        const o = el('#pk-ozet').value || veri.aciklama;
        const et = etiketUret();
        const kisaOzet = o.length > 150 ? o.slice(0, 147) + '…' : o;

        // X'te bağlantı uzunluğu ne olursa olsun 23 karakter sayılır
        const bagUzunluk = 23;
        const sabit = b.length + bagUzunluk + et.length + 6; // satır araları
        const xOzet = o.slice(0, Math.max(0, 280 - sabit)).replace(/\s+\S*$/, '');
        const xMetin = [b, xOzet, veri.adres + '\n' + et].filter(Boolean).join('\n\n');

        const setler = [
          { ad: 'X', metin: xMetin, sinir: 280, sayilan: xMetin.length - veri.adres.length + bagUzunluk },
          { ad: 'LinkedIn', metin: `${b}\n\n${o}\n\nDetaylar: ${veri.adres}\n\n${et}`, sinir: 3000 },
          { ad: 'Instagram', metin: `${b}\n\n${kisaOzet}\n\nBağlantı profilde 🔗\n\n${et}`, sinir: 2200 },
        ].map((s) => ({ ...s, sayilan: s.sayilan ?? s.metin.length }));

        el('#pk-metinler').innerHTML = setler
          .map(
            (s, i) => `<div class="pk-metin">
              <div class="pk-metin-bas"><strong>${s.ad}</strong>
              <span class="pk-sayac${s.sayilan > s.sinir ? ' asti' : ''}">${s.sayilan} / ${s.sinir}</span>
              <button type="button" class="pk-kopya" data-i="${i}">Kopyala</button></div>
              <pre>${s.metin.replace(/[<>&]/g, (c) => ({ '<': '&lt;', '>': '&gt;', '&': '&amp;' })[c])}</pre>
            </div>`
          )
          .join('');

        el('#pk-metinler')
          .querySelectorAll('.pk-kopya')
          .forEach((btn) => {
            btn.addEventListener('click', async () => {
              await navigator.clipboard.writeText(setler[+btn.dataset.i].metin);
              btn.textContent = 'Kopyalandı';
              setTimeout(() => (btn.textContent = 'Kopyala'), 1600);
            });
          });
      }

      /* ==================================================================
         İndirme
         ================================================================== */

      function indir(ad) {
        tuval.toBlob((blob) => {
          const a = document.createElement('a');
          a.href = URL.createObjectURL(blob);
          a.download = ad;
          a.click();
          setTimeout(() => URL.revokeObjectURL(a.href), 4000);
        }, 'image/png');
      }

      el('#pk-indir').addEventListener('click', () => indir(`${veri.alan}-${stilId}-${boyutId}.png`));

      /* ==================================================================
         AI arka plan — Cloudflare Workers AI / FLUX.1-schnell
         ================================================================== */

      const aiDurum = el('#pk-ai-durum');

      function aiTemizle() {
        aiGorsel = null;
        aiStil = null;
        el('#pk-ai-sil').hidden = true;
        aiDurum.textContent = '';
        aiDurum.className = 'pk-durum';
      }

      el('#pk-ai-sil').addEventListener('click', () => {
        aiTemizle();
        ciz();
      });

      el('#pk-ai').addEventListener('click', async () => {
        const btn = el('#pk-ai');
        btn.disabled = true;
        const yeniden = aiStil === stilId;
        btn.textContent = '✨ Üretiliyor…';
        aiDurum.textContent = 'Model çalışıyor, birkaç saniye sürebilir…';
        aiDurum.className = 'pk-durum';

        const tohum = Math.floor(Math.random() * 1e9);
        const renkler = veri ? `${veri.palet.vurgu},${veri.palet.vurgu2}` : '';
        const adres = `/api/gorsel-uret?stil=${encodeURIComponent(stilId)}&tohum=${tohum}&renkler=${encodeURIComponent(renkler)}`;

        try {
          const c = await fetch(adres);
          if (!c.ok) {
            const d = await c.json().catch(() => ({}));
            throw new Error(d.hata || 'Görsel üretilemedi.');
          }
          const blob = await c.blob();
          const im = new Image();
          const nesneAdres = URL.createObjectURL(blob);
          await new Promise((coz, at) => {
            im.onload = coz;
            im.onerror = () => at(new Error('Görsel çözülemedi.'));
            im.src = nesneAdres;
          });
          URL.revokeObjectURL(nesneAdres);

          aiGorsel = im;
          aiStil = stilId;
          el('#pk-ai-sil').hidden = false;
          aiDurum.textContent = yeniden ? 'Yeni bir varyasyon üretildi.' : 'AI arka plan uygulandı.';
          aiDurum.classList.add('ok');
          ciz();
        } catch (hata) {
          aiDurum.textContent = hata.message;
          aiDurum.classList.add('hata');
        } finally {
          btn.disabled = false;
          btn.textContent = aiStil === stilId ? '✨ Yeniden üret' : '✨ AI arka plan üret';
        }
      });

      el('#pk-tumu').addEventListener('click', async () => {
        const onceki = boyutId;
        for (const b of Object.keys(BOYUT)) {
          boyutId = b;
          ciz();
          indir(`${veri.alan}-${stilId}-${b}.png`);
          await new Promise((r) => setTimeout(r, 350));
        }
        boyutId = onceki;
        ciz();
      });

      /* ==================================================================
         Olaylar
         ================================================================== */

      function secimBagla(secici, geriCagri) {
        document.querySelectorAll(secici).forEach((d) => {
          d.addEventListener('click', () => {
            document.querySelectorAll(secici).forEach((k) => k.setAttribute('aria-checked', 'false'));
            d.setAttribute('aria-checked', 'true');
            geriCagri(d);
            ciz();
          });
        });
      }
      secimBagla('.pk-stil', (d) => {
        stilId = d.dataset.stil;
        // AI görseli üretildiği stile bağlı; başka stile geçince prosedürel zemine dönülür
        const eslesti = aiStil === stilId;
        el('#pk-ai').textContent = eslesti ? '✨ Yeniden üret' : '✨ AI arka plan üret';
        el('#pk-ai-sil').hidden = !eslesti;
        if (!eslesti) {
          aiDurum.textContent = '';
          aiDurum.className = 'pk-durum';
        }
      });
      secimBagla('.pk-boyut', (d) => (boyutId = d.dataset.boyut));

      ['#pk-rozet', '#pk-baslik', '#pk-ozet'].forEach((s) => {
        el(s).addEventListener('input', () => {
          ciz();
          metinleriYaz();
        });
      });

      el('#pk-form').addEventListener('submit', async (e) => {
        e.preventDefault();
        const durum = el('#pk-durum');
        const btn = el('#pk-btn');
        btn.disabled = true;
        durum.textContent = 'Site okunuyor…';
        durum.className = 'pk-durum';

        try {
          const c = await fetch('/api/tema-analiz?adres=' + encodeURIComponent(el('#pk-adres').value));
          const d = await c.json();
          if (!c.ok) throw new Error(d.hata || 'Site analiz edilemedi.');
          veri = d;

          el('#pk-rozet').value = d.siteAdi.slice(0, 40);
          el('#pk-baslik').value = d.baslik;
          el('#pk-ozet').value = d.aciklama;

          const tema = el('#pk-tema');
          tema.querySelector('.pk-tema-ad').textContent =
            `${d.alan} — ${d.stilSayisi} stil dosyası tarandı`;
          tema.querySelector('.pk-swatch-grup').innerHTML = d.palet.hepsi
            .slice(0, 8)
            .map((h) => `<i style="background:${h}" title="${h}"></i>`)
            .join('');
          tema.hidden = false;

          ['#pk-icerik-blok', '#pk-stil-blok', '#pk-onizleme-blok', '#pk-metin-blok'].forEach(
            (s) => (el(s).hidden = false)
          );
          durum.textContent = 'Tema okundu. Aşağıdan stil seçebilirsiniz.';
          durum.classList.add('ok');

          await (document.fonts ? document.fonts.ready : Promise.resolve());
          ciz();
          metinleriYaz();
          el('#pk-onizleme-blok').scrollIntoView({ behavior: 'smooth', block: 'start' });
        } catch (hata) {
          durum.textContent = hata.message;
          durum.classList.add('hata');
        } finally {
          btn.disabled = false;
        }
      });
    })();
  </script>

  <style>
    .pk {
      padding: 28px 0 64px;
      display: grid;
      gap: 30px;
    }
    .pk-blok {
      background: var(--paper);
      border: 1px solid var(--line);
      border-radius: var(--r-l);
      padding: 24px;
    }
    .pk-h2 {
      display: flex;
      align-items: center;
      gap: 10px;
      font-size: 18px;
      margin: 0 0 16px;
    }
    .pk-no {
      display: grid;
      place-items: center;
      width: 26px;
      height: 26px;
      border-radius: 50%;
      background: var(--tint);
      color: var(--indigo-d);
      font-size: 13px;
      font-weight: 800;
      flex: none;
    }
    .pk-form {
      display: flex;
      gap: 10px;
      flex-wrap: wrap;
    }
    .pk-form input {
      flex: 1 1 260px;
      min-width: 0;
      padding: 12px 14px;
      font: inherit;
      border: 1px solid var(--line);
      border-radius: var(--r-s);
      background: var(--bg);
    }
    .pk-form input:focus-visible,
    .pk-alanlar :is(input, textarea):focus-visible {
      outline: 2px solid var(--indigo);
      outline-offset: 1px;
    }
    .pk-durum {
      font-size: 13px;
      color: var(--muted);
      margin: 12px 0 0;
      min-height: 1.2em;
    }
    .pk-durum.ok {
      color: var(--green-ink);
    }
    .pk-durum.hata {
      color: var(--clay-ink);
    }
    .pk-tema {
      display: flex;
      align-items: center;
      gap: 12px;
      flex-wrap: wrap;
      margin-top: 12px;
      font-size: 13px;
      color: var(--muted);
    }
    .pk-swatch-grup {
      display: flex;
      gap: 5px;
    }
    .pk-swatch-grup i {
      width: 22px;
      height: 22px;
      border-radius: 5px;
      border: 1px solid var(--line);
    }
    .pk-alanlar {
      display: grid;
      gap: 14px;
    }
    .pk-alanlar label {
      display: grid;
      gap: 6px;
      font-size: 13px;
      font-weight: 700;
      color: var(--ink-soft);
    }
    .pk-alanlar :is(input, textarea) {
      font: inherit;
      font-weight: 400;
      padding: 10px 12px;
      border: 1px solid var(--line);
      border-radius: var(--r-s);
      background: var(--bg);
      resize: vertical;
    }

    .pk-galeri {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(112px, 1fr));
      gap: 12px;
    }
    .pk-stil {
      position: relative;
      aspect-ratio: 1;
      border: 0;
      border-radius: var(--r-m);
      background: var(--kart);
      cursor: pointer;
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      gap: 10px;
      padding: 8px;
      box-shadow: 0 1px 3px rgb(22 32 58 / 18%);
      transition: transform 0.14s ease;
    }
    .pk-stil:hover {
      transform: translateY(-2px);
    }
    .pk-stil-ikon {
      font-size: 30px;
      line-height: 1;
    }
    .pk-stil-ad {
      font-size: 11px;
      font-weight: 900;
      letter-spacing: 0.04em;
      text-transform: uppercase;
      color: #fff;
      text-shadow: 0 1px 3px rgb(0 0 0 / 45%);
      text-align: center;
    }
    .pk-stil[data-stil='suluboya'] .pk-stil-ad,
    .pk-stil[data-stil='minimal'] .pk-stil-ad {
      color: #3b3550;
      text-shadow: none;
    }
    .pk-stil[aria-checked='true'] {
      outline: 3px solid var(--indigo);
      outline-offset: 2px;
    }

    .pk-boyutlar {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
      gap: 10px;
      margin-bottom: 18px;
    }
    .pk-boyut {
      display: grid;
      gap: 2px;
      text-align: left;
      padding: 11px 13px;
      border: 1px solid var(--line);
      border-radius: var(--r-s);
      background: var(--bg);
      cursor: pointer;
      font: inherit;
    }
    .pk-boyut strong {
      font-size: 14px;
    }
    .pk-boyut span {
      font-size: 12px;
      color: var(--ink-soft);
    }
    .pk-boyut em {
      font-size: 11px;
      color: var(--muted);
      font-style: normal;
    }
    .pk-boyut[aria-checked='true'] {
      border-color: var(--indigo);
      background: var(--tint);
    }

    .pk-tuval-kutu {
      background: var(--bg);
      border: 1px solid var(--line);
      border-radius: var(--r-m);
      padding: 16px;
      display: grid;
      place-items: center;
    }
    #pk-tuval {
      max-width: 100%;
      max-height: 62vh;
      height: auto;
      border-radius: var(--r-s);
      box-shadow: 0 2px 10px rgb(22 32 58 / 16%);
    }
    .pk-eylem {
      display: flex;
      gap: 10px;
      flex-wrap: wrap;
      margin-top: 16px;
    }
    .dg-ikincil {
      background: var(--paper);
      color: var(--indigo-d);
      border: 1px solid var(--indigo);
    }
    .dg-ai {
      background-image: linear-gradient(96deg, #3a45e0, #7b3fd4 55%, #e8901a);
      border: 0;
    }
    .dg-ai[disabled] {
      opacity: 0.62;
      cursor: progress;
    }

    .pk-metinler {
      display: grid;
      gap: 14px;
    }
    .pk-metin {
      border: 1px solid var(--line);
      border-radius: var(--r-s);
      overflow: hidden;
    }
    .pk-metin-bas {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 9px 13px;
      background: var(--bg);
      border-bottom: 1px solid var(--line);
      font-size: 13px;
    }
    .pk-metin-bas strong {
      margin-right: auto;
    }
    .pk-sayac {
      font-size: 12px;
      color: var(--muted);
      font-variant-numeric: tabular-nums;
      margin-right: 10px;
    }
    .pk-sayac.asti {
      color: var(--clay-ink);
      font-weight: 700;
    }
    .pk-kopya {
      font: inherit;
      font-size: 12px;
      font-weight: 700;
      padding: 4px 11px;
      border-radius: 999px;
      border: 1px solid var(--indigo);
      background: var(--paper);
      color: var(--indigo-d);
      cursor: pointer;
    }
    .pk-metin pre {
      margin: 0;
      padding: 13px;
      font: inherit;
      font-size: 13.5px;
      line-height: 1.55;
      white-space: pre-wrap;
      word-break: break-word;
    }

    @media (max-width: 560px) {
      .pk-blok {
        padding: 18px 15px;
      }
      .pk-galeri {
        grid-template-columns: repeat(3, 1fr);
      }
    }
  </style>
</Base>
