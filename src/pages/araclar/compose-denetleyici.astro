      font-weight: 600;
      white-space: nowrap;
    }
    .c-tablo code {
      font-size: 12px;
    }
    .c-yok {
      color: light-dark(#b45309, #fbbf24);
    }
    .c-ipuclari {
      list-style: none;
      margin: 0;
