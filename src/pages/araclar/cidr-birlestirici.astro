---
import Base from '../../layouts/Base.astro';
---

<Base
  baslik="CIDR birleştirici ve bölücü"
  aciklama="Dağınık IP bloklarını en az sayıda CIDR'a indirger, çakışanları bulur ve bir bloğu eşit ya da değişken uzunlukta alt ağlara böler. Güvenlik duvarı kural setini sadeleştirmek için."
  aramaya={true}
  kategori="Araç"
>
  <div class="arama-bas">
    <div class="kap">
      <nav class="kirinti" aria-label="Kırıntı yolu" style="padding-top:0">
        <a href="/">Ana sayfa</a><span class="ayrac">/</span><a href="/araclar">Araçlar</a><span
          class="ayrac">/</span
        ><span aria-current="page">CIDR birleştirici</span>
      </nav>
      <h1>CIDR birleştirici ve bölücü</h1>
      <p style="color:var(--muted);font-size:14px;margin-top:8px;max-width:66ch">
        Yıllar içinde biriken kural setlerinde aynı adres onlarca satırda geçer. Blokları
        birleştirmek hem kural sayısını düşürür hem de çakışmayı görünür kılar. Hesap tarayıcıda
        yapılır; girdiğiniz adresler hiçbir yere gönderilmez.
      </p>
    </div>
  </div>

  <div class="kap arac-sayfa">
    <section class="arac-blok">
      <h2 class="arac-h2"><span class="arac-no">1</span> Bloklar</h2>
      <div class="arac-alan">
        <label for="c-girdi">Her satıra bir blok — CIDR, tek adres ya da aralık</label>
        <textarea id="c-girdi" rows="8" spellcheck="false"></textarea>
        <small>
          Kabul edilen biçimler: <code>10.0.0.0/24</code>, <code>192.168.1.5</code>,
          <code>10.0.0.0-10.0.0.255</code>
        </small>
      </div>
      <div class="arac-dugmeler">
        <button type="button" class="dg" id="c-hesapla">Birleştir</button>
        <button type="button" class="dg dg-hayalet" id="c-ornek">Örnek doldur</button>
        <button type="button" class="dg dg-hayalet" id="c-temizle">Temizle</button>
      </div>
      <p class="arac-durum" id="c-durum" role="status" aria-live="polite"></p>
    </section>

    <section class="arac-blok" id="c-sonuc-blok" hidden>
      <h2 class="arac-h2"><span class="arac-no">2</span> Sonuç</h2>
      <div class="arac-olcum" id="c-olcum"></div>

      <div class="c-ikili">
        <div>
          <span class="yan-etiket">Birleştirilmiş bloklar</span>
          <div style="position:relative">
            <pre class="kod"><code id="c-cikti"></code></pre>
            <button class="kopyala" type="button" id="c-kopyala">Kopyala</button>
          </div>
        </div>
        <div>
          <span class="yan-etiket">Notlar</span>
          <ul class="c-notlar" id="c-notlar"></ul>
        </div>
      </div>
    </section>

    <section class="arac-blok">
      <h2 class="arac-h2"><span class="arac-no">3</span> Bir bloğu böl</h2>
      <div class="arac-alanlar">
        <label class="arac-alan"
          >Bölünecek blok
          <input id="c-bol-blok" type="text" spellcheck="false" placeholder="10.10.0.0/16" />
        </label>
        <label class="arac-alan"
          >Hedef önek
          <input id="c-bol-onek" type="number" min="1" max="32" value="24" />
        </label>
      </div>
      <div class="arac-dugmeler">
        <button type="button" class="dg dg-hayalet" id="c-bol">Böl</button>
      </div>
      <p class="arac-durum" id="c-bol-durum" role="status" aria-live="polite"></p>
      <div style="position:relative" id="c-bol-kutu" hidden>
        <pre class="kod"><code id="c-bol-cikti"></code></pre>
        <button class="kopyala" type="button" id="c-bol-kopyala">Kopyala</button>
      </div>
    </section>

    <section class="arac-blok">
      <h2 class="arac-h2"><span class="arac-no">4</span> Neden birleştirme?</h2>
      <p class="arac-not">
        Birleştirme yalnızca <b>bitişik ve hizalı</b> bloklarda yapılabilir:
        <code>10.0.0.0/25</code> ile <code>10.0.0.128/25</code> birleşip <code>10.0.0.0/24</code>
        olur, ama <code>10.0.0.128/25</code> ile <code>10.0.1.0/25</code> birleşmez — aradaki sınır
        hizalı değildir. Araç bunu kendisi denetler; birleşemeyen blokları ayrı bırakır.
      </p>
      <p class="arac-not">
        <b>Kapsam hiç değişmez.</b> Araç yalnızca bitişik ve çakışan aralıkları kaynaştırır;
        aradaki boşluğu doldurmaz. <code>10.0.0.0/25</code> ile <code>10.0.2.0/25</code> arasında
        <code>10.0.1.0/24</code> boşluğu vardır, araç bu ikisini birleştirmez — sonuç iki ayrı
        satır kalır. Yani çıktıyı kurala yazdığınızda hiçbir zaman istemediğiniz bir adres
        kapsanmaz. Sayaç bunu her hesapta doğrular.
      </p>
      <p class="arac-not">
        Kural setinde <b>çakışma</b> ayrı bir konudur: aynı adresin birden fazla satırda geçmesi
        genelde iki ekibin habersiz kural eklemesinden gelir. Araç bunu bulur ve kaç adresin
        tekrarlandığını söyler; silmeden önce her satırın neden eklendiğine bakın.
      </p>
    </section>
  </div>

  <script>
    (() => {
      const el = (s) => document.querySelector(s);

      /* --- IPv4 <-> sayı ---------------------------------------------------- */
      const sayiya = (ip) =>
        ip.split('.').reduce((t, o) => t * 256 + Number(o), 0) >>> 0;

      const ipye = (n) =>
        [(n >>> 24) & 255, (n >>> 16) & 255, (n >>> 8) & 255, n & 255].join('.');

      const ipGecerli = (ip) =>
        /^\d{1,3}(\.\d{1,3}){3}$/.test(ip) && ip.split('.').every((o) => Number(o) <= 255);

      /** Girdi satırını [baslangic, bitis] aralığına çevirir. */
      function araligaCevir(satir) {
        const t = satir.trim();
        if (!t) return null;

        if (t.includes('/')) {
          const [ip, onekHam] = t.split('/');
          const onek = Number(onekHam);
          if (!ipGecerli(ip) || !Number.isInteger(onek) || onek < 0 || onek > 32) return { hata: t };
          const boyut = onek === 0 ? 4294967296 : 2 ** (32 - onek);
          // Ağ adresine hizala: 10.0.0.5/24 yazan çok olur, /24'ün ağı 10.0.0.0'dır
          const bas = Math.floor(sayiya(ip) / boyut) * boyut;
          return { bas, son: bas + boyut - 1, hizalandi: bas !== sayiya(ip) };
        }

        if (t.includes('-')) {
          const [a, b] = t.split('-').map((x) => x.trim());
          if (!ipGecerli(a) || !ipGecerli(b)) return { hata: t };
          const bas = sayiya(a);
          const son = sayiya(b);
          return bas <= son ? { bas, son } : { bas: son, son: bas };
        }

        if (!ipGecerli(t)) return { hata: t };
        const n = sayiya(t);
        return { bas: n, son: n };
      }

      /** Bir aralığı kapsayan en az sayıda CIDR üretir. */
      function araligiCidra(bas, son) {
        const sonuc = [];
        let su = bas;
        while (su <= son) {
          // Bu adresten başlayabilecek en büyük hizalı blok
          let maks = 32;
          while (maks > 0) {
            const boyut = 2 ** (32 - (maks - 1));
            if (su % boyut !== 0 || su + boyut - 1 > son) break;
            maks--;
          }
          sonuc.push(`${ipye(su)}/${maks}`);
          su += 2 ** (32 - maks);
          if (su === 0) break; // 0.0.0.0/0 taşması
        }
        return sonuc;
      }

      /* --- birleştirme ------------------------------------------------------ */
      function birlestir(araliklar) {
        const sirali = [...araliklar].sort((a, b) => a.bas - b.bas || a.son - b.son);
        const kaynasmis = [];
        for (const a of sirali) {
          const son = kaynasmis[kaynasmis.length - 1];
          // Bitişik aralıklar da kaynaşır: 10.0.0.255 ile 10.0.1.0 arada boşluk yok
          if (son && a.bas <= son.son + 1) {
            son.son = Math.max(son.son, a.son);
          } else {
            kaynasmis.push({ ...a });
          }
        }
        return kaynasmis;
      }

      /* --- çizim ------------------------------------------------------------ */
      function hesapla() {
        const durum = el('#c-durum');
        const satirlar = el('#c-girdi').value.split('\n').filter((s) => s.trim());
        if (!satirlar.length) {
          durum.className = 'arac-durum hata';
          durum.textContent = 'En az bir blok girin.';
          return;
        }

        const araliklar = [];
        const hatalar = [];
        const hizalananlar = [];
        for (const s of satirlar) {
          const a = araligaCevir(s);
          if (!a) continue;
          if (a.hata) {
            hatalar.push(a.hata);
            continue;
          }
          if (a.hizalandi) hizalananlar.push(s.trim());
          araliklar.push(a);
        }

        if (!araliklar.length) {
          durum.className = 'arac-durum hata';
          durum.textContent = 'Hiçbir satır çözümlenemedi.';
          return;
        }

        const oncekiAdres = araliklar.reduce((t, a) => t + (a.son - a.bas + 1), 0);
        const kaynasmis = birlestir(araliklar);
        const cidrlar = kaynasmis.flatMap((a) => araligiCidra(a.bas, a.son));
        const sonrakiAdres = kaynasmis.reduce((t, a) => t + (a.son - a.bas + 1), 0);

        el('#c-sonuc-blok').hidden = false;
        el('#c-cikti').textContent = cidrlar.join('\n');

        el('#c-olcum').innerHTML =
          `<span>Girdi: <b>${araliklar.length}</b> blok</span>` +
          `<span>Sonuç: <b>${cidrlar.length}</b> blok</span>` +
          `<span>Kapsanan adres: <b>${sonrakiAdres.toLocaleString('tr-TR')}</b></span>` +
          `<span>Kazanç: <b>${araliklar.length - cidrlar.length}</b> satır</span>`;

        const notlar = [];
        const cakisan = oncekiAdres - sonrakiAdres;
        if (cakisan > 0) {
          notlar.push(
            `<b>Çakışma bulundu:</b> girdi satırları toplamda ` +
              `${oncekiAdres.toLocaleString('tr-TR')} adres sayıyor ama birleşimleri ` +
              `${sonrakiAdres.toLocaleString('tr-TR')} adres. Aradaki ` +
              `${cakisan.toLocaleString('tr-TR')} adres birden fazla satırda geçiyordu — ` +
              `kural setinde bu tür tekrarlar sessizce birikir.`
          );
        } else {
          notlar.push('Girdi satırları arasında çakışma yok; her adres tek satırda geçiyordu.');
        }
        notlar.push(
          `Sonuç girdiyle <b>tam olarak aynı</b> ${sonrakiAdres.toLocaleString('tr-TR')} adresi ` +
            `kapsıyor — ne bir fazla, ne bir eksik.`
        );
        if (hizalananlar.length) {
          notlar.push(
            `Ağ adresine hizalandı: <code>${hizalananlar.join('</code>, <code>')}</code>`
          );
        }
        if (hatalar.length) {
          notlar.push(`<b>Çözümlenemedi:</b> <code>${hatalar.join('</code>, <code>')}</code>`);
        }
        el('#c-notlar').innerHTML = notlar.map((n) => `<li>${n}</li>`).join('');

        durum.className = 'arac-durum ok';
        durum.textContent = `${araliklar.length} blok → ${cidrlar.length} blok.`;
      }

      /* --- bölme ------------------------------------------------------------ */
      function bol() {
        const durum = el('#c-bol-durum');
        const a = araligaCevir(el('#c-bol-blok').value);
        const hedef = Number(el('#c-bol-onek').value);

        if (!a || a.hata) {
          durum.className = 'arac-durum hata';
          durum.textContent = 'Geçerli bir blok girin.';
          return;
        }

        const mevcutBoyut = a.son - a.bas + 1;
        const hedefBoyut = 2 ** (32 - hedef);
        if (hedefBoyut > mevcutBoyut) {
          durum.className = 'arac-durum hata';
          durum.textContent = 'Hedef önek bloktan büyük olamaz.';
          return;
        }

        const adet = mevcutBoyut / hedefBoyut;
        if (adet > 4096) {
          durum.className = 'arac-durum hata';
          durum.textContent = `${adet.toLocaleString('tr-TR')} alt ağ çıkar — çok fazla. Daha büyük bir önek seçin.`;
          return;
        }

        const parcalar = [];
        for (let i = 0; i < adet; i++) {
          const bas = a.bas + i * hedefBoyut;
          parcalar.push(`${ipye(bas)}/${hedef}`);
        }

        el('#c-bol-kutu').hidden = false;
        el('#c-bol-cikti').textContent = parcalar.join('\n');
        durum.className = 'arac-durum ok';
        durum.textContent = `${adet} alt ağ, her biri ${(hedefBoyut - 2).toLocaleString('tr-TR')} kullanılabilir adres.`;
      }

      /* --- olaylar ---------------------------------------------------------- */
      el('#c-hesapla').addEventListener('click', hesapla);
      el('#c-bol').addEventListener('click', bol);

      el('#c-ornek').addEventListener('click', () => {
        el('#c-girdi').value = [
          '10.0.0.0/25',
          '10.0.0.128/25',
          '10.0.1.0/24',
          '192.168.1.5',
          '192.168.1.6',
          '192.168.1.7',
          '172.16.0.0-172.16.0.255',
          '10.0.0.64/26',
        ].join('\n');
        hesapla();
      });

      el('#c-temizle').addEventListener('click', () => {
        el('#c-girdi').value = '';
        el('#c-sonuc-blok').hidden = true;
        el('#c-durum').textContent = '';
      });

      for (const [dugme, kaynak] of [
        ['#c-kopyala', '#c-cikti'],
        ['#c-bol-kopyala', '#c-bol-cikti'],
      ]) {
        el(dugme).addEventListener('click', async (e) => {
          try {
            await navigator.clipboard.writeText(el(kaynak).textContent);
            e.currentTarget.dataset.durum = 'kopyalandi';
            e.currentTarget.textContent = 'Kopyalandı';
            setTimeout(() => {
              e.currentTarget.dataset.durum = '';
              e.currentTarget.textContent = 'Kopyala';
            }, 1600);
          } catch {
            /* pano izni yoksa kullanıcı elle seçer */
          }
        });
      }
    })();
  </script>

  <style>
    .arac-dugmeler {
      display: flex;
      gap: 10px;
      flex-wrap: wrap;
      margin-top: 4px;
    }
    .c-ikili {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(min(280px, 100%), 1fr));
      gap: 20px;
      margin-top: 14px;
    }
    .c-notlar {
      list-style: none;
      margin: 8px 0 0;
      padding: 0;
      display: grid;
      gap: 9px;
    }
    .c-notlar li {
      font-size: 13.5px;
      line-height: 1.55;
      color: var(--ink-soft);
      border-left: 2px solid var(--line);
      padding-left: 12px;
    }
    .c-notlar code {
      font-size: 12px;
    }
  </style>
</Base>
