---
import Base from '../../layouts/Base.astro';

const sehirler = [
  { ad: 'İstanbul', dilim: 'Europe/Istanbul', not: 'Merkez' },
  { ad: 'Berlin', dilim: 'Europe/Berlin', not: 'Avrupa veri merkezi' },
  { ad: 'Londra', dilim: 'Europe/London', not: '' },
  { ad: 'Dubai', dilim: 'Asia/Dubai', not: '' },
  { ad: 'Bakü', dilim: 'Asia/Baku', not: '' },
  { ad: 'Moskova', dilim: 'Europe/Moscow', not: '' },
  { ad: 'Yeni Delhi', dilim: 'Asia/Kolkata', not: 'Yarım saatlik fark' },
  { ad: 'Singapur', dilim: 'Asia/Singapore', not: '' },
  { ad: 'Tokyo', dilim: 'Asia/Tokyo', not: '' },
  { ad: 'New York', dilim: 'America/New_York', not: 'ABD doğu' },
  { ad: 'Şikago', dilim: 'America/Chicago', not: '' },
  { ad: 'Los Angeles', dilim: 'America/Los_Angeles', not: 'ABD batı' },
  { ad: 'São Paulo', dilim: 'America/Sao_Paulo', not: '' },
  { ad: 'Sidney', dilim: 'Australia/Sydney', not: 'Güney yarımküre' },
  { ad: 'UTC', dilim: 'UTC', not: 'Günlüklerin dili' },
];
---

<Base
  baslik="Bakım penceresi ve zaman dilimi planlayıcı"
  aciklama="Seçtiğiniz bakım saatinin her lokasyonda kaça geldiğini, mesai saatine denk gelip gelmediğini ve yaz saati tuzaklarını gösterir."
  aramaya={true}
  kategori="Araç"
>
  <div class="arama-bas">
    <div class="kap">
      <nav class="kirinti" aria-label="Kırıntı yolu" style="padding-top:0">
        <a href="/">Ana sayfa</a><span class="ayrac">/</span><a href="/araclar">Araçlar</a><span
          class="ayrac">/</span
        ><span aria-current="page">Bakım penceresi planlayıcı</span>
      </nav>
      <h1>Bakım penceresi ve zaman dilimi planlayıcı</h1>
      <p style="color:var(--muted);font-size:14px;margin-top:8px;max-width:66ch">
        Gece iki, İstanbul'da sessiz bir saat; Los Angeles'ta öğleden sonra dört. Bakım
        penceresini duyurmadan önce hangi lokasyonun mesai saatine denk geldiğini görün.
        Yaz saati geçişleri ve UTC kayması da hesaba katılır.
      </p>
    </div>
  </div>

  <div class="kap arac-sayfa">
    <section class="arac-blok">
      <h2 class="arac-h2"><span class="arac-no">1</span> Pencere</h2>
      <div class="arac-alanlar">
        <label class="arac-alan"
          >Başlangıç
          <input id="z-baslangic" type="datetime-local" />
        </label>
        <label class="arac-alan"
          >Süre (dakika)
          <input id="z-sure" type="number" min="5" max="1440" step="5" value="120" />
        </label>
        <label class="arac-alan"
          >Referans dilim
          <select id="z-referans">
            {sehirler.map((s) => <option value={s.dilim} selected={s.dilim === 'Europe/Istanbul'}>{s.ad}</option>)}
          </select>
          <small>Yukarıdaki saat bu dilime göre okunur.</small>
        </label>
        <label class="arac-alan"
          >Mesai saatleri
          <select id="z-mesai">
            <option value="9-18">09:00 – 18:00</option>
            <option value="8-17">08:00 – 17:00</option>
            <option value="0-24">Yirmi dört saat (kesinti kabul edilemez)</option>
          </select>
        </label>
      </div>
      <p class="arac-durum" id="z-durum" role="status" aria-live="polite"></p>
    </section>

    <section class="arac-blok">
      <h2 class="arac-h2"><span class="arac-no">2</span> Lokasyonlar</h2>
      <div class="z-kaydir">
        <table class="z-tablo">
          <thead>
            <tr><th>Lokasyon</th><th>Başlangıç</th><th>Bitiş</th><th>UTC farkı</th><th>Durum</th></tr>
          </thead>
          <tbody id="z-tablo"></tbody>
        </table>
      </div>
    </section>

    <section class="arac-blok">
      <h2 class="arac-h2"><span class="arac-no">3</span> Duyuru metni</h2>
      <div style="position:relative">
        <pre class="kod"><code id="z-duyuru"></code></pre>
        <button class="kopyala" type="button" data-kaynak="z-duyuru">Kopyala</button>
      </div>
    </section>

    <section class="arac-blok">
      <h2 class="arac-h2"><span class="arac-no">4</span> Uyarılar</h2>
      <div id="z-uyarilar"></div>
    </section>

    <section class="arac-blok">
      <h2 class="arac-h2"><span class="arac-no">5</span> Zamanla ilgili tuzaklar</h2>
      <ul class="z-ipuclari">
        <li>
          <b>Türkiye'de yaz saati uygulaması yok.</b> 2016'dan beri kalıcı UTC+03. Ama
          Avrupa'da var: kışın İstanbul ile Berlin arasında iki saat, yazın bir saat fark
          olur. "Her zaman iki saat ileriyiz" varsayımıyla kurulan zamanlanmış görevler yılda
          iki kez yanlış saatte çalışır.
        </li>
        <li>
          <b>Günlükleri UTC tutun.</b> Farklı dilimlerdeki sunucuların günlüklerini
          birleştirirken yerel saat işe yaramaz; olayların sırasını yanlış görürsünüz. Sunucu
          saatini UTC yapmak, olay incelemesini kolaylaştıran en ucuz karardır.
        </li>
        <li>
          <b>Yaz saati geçişinde bazı saatler ya yoktur ya iki kez vardır.</b> İleri alınan gece
          02:30 hiç yaşanmaz; geri alınan gece 02:30 iki kez yaşanır. Bu saatlere zamanlanmış
          bir görev ya hiç çalışmaz ya iki kez çalışır. Kritik işleri 01:00 öncesine ya da
          04:00 sonrasına alın.
        </li>
        <li>
          <b>Yarım saatlik dilimler vardır.</b> Hindistan UTC+05:30, İran UTC+03:30, Nepal
          UTC+05:45. "Saat farkı tam sayıdır" varsayan hesaplar bu ülkelerde bozulur.
        </li>
        <li>
          <b>Güney yarımkürede mevsimler ters.</b> Sidney'in yaz saati bizim kışımıza denk
          gelir; İstanbul ile arasındaki fark yıl içinde 7 ile 9 saat arasında değişir. Sabit
          fark varsayarak toplantı kuran her takvim daveti yılda iki kez kayar.
        </li>
      </ul>
    </section>
  </div>

  <script>
    (() => {
      const el = (s) => document.querySelector(s);

      const SEHIRLER = [
        ['İstanbul', 'Europe/Istanbul'],
        ['Berlin', 'Europe/Berlin'],
        ['Londra', 'Europe/London'],
        ['Dubai', 'Asia/Dubai'],
        ['Bakü', 'Asia/Baku'],
        ['Moskova', 'Europe/Moscow'],
        ['Yeni Delhi', 'Asia/Kolkata'],
        ['Singapur', 'Asia/Singapore'],
        ['Tokyo', 'Asia/Tokyo'],
        ['New York', 'America/New_York'],
        ['Şikago', 'America/Chicago'],
        ['Los Angeles', 'America/Los_Angeles'],
        ['São Paulo', 'America/Sao_Paulo'],
        ['Sidney', 'Australia/Sydney'],
        ['UTC', 'UTC'],
      ];

      /** Bir anın verilen dilimdeki saat, dakika, gün ve hafta günü değerleri. */
      function dilimdeParcala(an, dilim) {
        const bicimlendirici = new Intl.DateTimeFormat('tr-TR', {
          timeZone: dilim,
          year: 'numeric',
          month: '2-digit',
          day: '2-digit',
          hour: '2-digit',
          minute: '2-digit',
          weekday: 'short',
          hour12: false,
        });
        const parcalar = {};
        for (const p of bicimlendirici.formatToParts(an)) parcalar[p.type] = p.value;
        return {
          yil: Number(parcalar.year),
          ay: Number(parcalar.month),
          gun: Number(parcalar.day),
          saat: Number(parcalar.hour) % 24,
          dakika: Number(parcalar.minute),
          haftaGunu: parcalar.weekday,
        };
      }

      /** Dilimin o andaki UTC farkı (dakika). */
      function utcFarki(an, dilim) {
        const p = dilimdeParcala(an, dilim);
        // Dilimdeki yerel saati UTC sanarak kur, gerçek anla farkını al
        const sanki = Date.UTC(p.yil, p.ay - 1, p.gun, p.saat, p.dakika);
        return Math.round((sanki - an.getTime()) / 60000);
      }

      const farkYaz = (dakika) => {
        const isaret = dakika < 0 ? '−' : '+';
        const m = Math.abs(dakika);
        return `UTC${isaret}${String(Math.floor(m / 60)).padStart(2, '0')}:${String(m % 60).padStart(2, '0')}`;
      };

      /** Referans dilimde yazılan yerel saati gerçek bir ana çevirir. */
      function anaCevir(metin, dilim) {
        const [tarih, saat] = metin.split('T');
        const [yil, ay, gun] = tarih.split('-').map(Number);
        const [sa, dk] = saat.split(':').map(Number);

        // Önce UTC sayıp farkı ölçüyor, sonra düzeltiyoruz. Yaz saati sınırında
        // fark değişebildiği için düzeltmeyi bir kez daha uyguluyoruz.
        let tahmin = Date.UTC(yil, ay - 1, gun, sa, dk);
        for (let i = 0; i < 2; i++) {
          const fark = utcFarki(new Date(tahmin), dilim);
          tahmin = Date.UTC(yil, ay - 1, gun, sa, dk) - fark * 60000;
        }
        return new Date(tahmin);
      }

      const zamanYaz = (p) =>
        `${String(p.gun).padStart(2, '0')}.${String(p.ay).padStart(2, '0')} ` +
        `${String(p.saat).padStart(2, '0')}:${String(p.dakika).padStart(2, '0')} ${p.haftaGunu}`;

      function hesapla() {
        const metin = el('#z-baslangic').value;
        if (!metin) return;

        const referans = el('#z-referans').value;
        const sure = Number(el('#z-sure').value) || 60;
        const [mesaiBas, mesaiSon] = el('#z-mesai').value.split('-').map(Number);

        const baslangic = anaCevir(metin, referans);
        const bitis = new Date(baslangic.getTime() + sure * 60000);

        const satirlar = [];
        const uyarilar = [];
        let mesaideOlan = 0;

        for (const [ad, dilim] of SEHIRLER) {
          const b = dilimdeParcala(baslangic, dilim);
          const s = dilimdeParcala(bitis, dilim);
          const fark = utcFarki(baslangic, dilim);
          const farkBitis = utcFarki(bitis, dilim);

          const haftaSonu = ['Cmt', 'Paz'].some((g) => b.haftaGunu.startsWith(g));
          // Mesai çakışması: pencerenin herhangi bir anı mesai saatlerine giriyor mu?
          const bitisSaat = b.saat + sure / 60;
          const mesaide =
            mesaiSon - mesaiBas >= 24
              ? !haftaSonu
              : !haftaSonu && bitisSaat > mesaiBas && b.saat < mesaiSon;

          if (mesaide) mesaideOlan++;

          satirlar.push(
            `<tr data-durum="${mesaide ? 'mesai' : haftaSonu ? 'haftasonu' : 'uygun'}">` +
              `<td><b>${ad}</b></td>` +
              `<td>${zamanYaz(b)}</td>` +
              `<td>${zamanYaz(s)}</td>` +
              `<td>${farkYaz(fark)}</td>` +
              `<td>${mesaide ? 'Mesai saati' : haftaSonu ? 'Hafta sonu' : 'Uygun'}</td>` +
              `</tr>`
          );

          if (fark !== farkBitis) {
            uyarilar.push([
              'hata',
              `<b>${ad}: pencere yaz saati geçişine denk geliyor.</b> Başlangıçta ` +
                `${farkYaz(fark)}, bitişte ${farkYaz(farkBitis)}. Bu gecede bazı saatler ya hiç ` +
                `yaşanmaz ya iki kez yaşanır; zamanlanmış görevler ve süre hesapları şaşar. ` +
                `Bakımı başka bir güne alın.`,
            ]);
          }
        }

        el('#z-tablo').innerHTML = satirlar.join('');

        /* --- durum --- */
        const durum = el('#z-durum');
        if (mesaideOlan === 0) {
          durum.className = 'arac-durum ok';
          durum.textContent = 'Hiçbir lokasyonda mesai saatine denk gelmiyor.';
        } else {
          durum.className = 'arac-durum hata';
          durum.textContent = `${mesaideOlan} lokasyonda mesai saatine denk geliyor.`;
        }

        /* --- ek uyarılar --- */
        const ist = dilimdeParcala(baslangic, 'Europe/Istanbul');
        if (['Cum'].some((g) => ist.haftaGunu.startsWith(g)) && ist.saat >= 16) {
          uyarilar.push([
            'uyari',
            '<b>Cuma akşamı bakım.</b> Bir şey ters giderse hafta sonu boyunca eksik ekiple ' +
              'uğraşırsınız. Geri alma planınız gerçekten sınanmadıysa bu pencereyi salıya alın.',
          ]);
        }

        if (sure > 240) {
          uyarilar.push([
            'uyari',
            `<b>${Math.round(sure / 60)} saatlik pencere uzun.</b> Uzun pencerelerin sonunda ` +
              `ekip yorulur ve hata oranı artar. İşi bölüp iki ayrı pencereye yaymak, tek bir ` +
              `uzun geceden genelde daha güvenlidir.`,
          ]);
        }

        const hindistan = utcFarki(baslangic, 'Asia/Kolkata');
        if (hindistan % 60 !== 0) {
          uyarilar.push([
            'ok',
            `<b>Yarım saatlik dilim var.</b> Yeni Delhi ${farkYaz(hindistan)} — saat farkının ` +
              `tam sayı olduğunu varsayan takvim davetleri ve betikler burada yarım saat kayar.`,
          ]);
        }

        if (!uyarilar.length) {
          uyarilar.push(['ok', '<b>Zamanla ilgili özel bir tuzak görünmüyor.</b>']);
        }

        el('#z-uyarilar').innerHTML =
          '<ul class="z-liste">' +
          uyarilar.map(([tip, m]) => `<li data-tip="${tip}">${m}</li>`).join('') +
          '</ul>';

        /* --- duyuru metni --- */
        const utcBas = dilimdeParcala(baslangic, 'UTC');
        const istBas = dilimdeParcala(baslangic, 'Europe/Istanbul');
        const istSon = dilimdeParcala(bitis, 'Europe/Istanbul');

        el('#z-duyuru').textContent =
          `Planlı bakım bildirimi\n` +
          `${'='.repeat(40)}\n\n` +
          `Tarih  : ${istBas.gun}.${String(istBas.ay).padStart(2, '0')}.${istBas.yil} ${istBas.haftaGunu}\n` +
          `Saat   : ${String(istBas.saat).padStart(2, '0')}:${String(istBas.dakika).padStart(2, '0')} – ` +
          `${String(istSon.saat).padStart(2, '0')}:${String(istSon.dakika).padStart(2, '0')} (Türkiye saati)\n` +
          `UTC    : ${String(utcBas.saat).padStart(2, '0')}:${String(utcBas.dakika).padStart(2, '0')}\n` +
          `Süre   : ${sure} dakika\n\n` +
          `Diğer lokasyonlarda başlangıç saati:\n` +
          SEHIRLER.filter(([ad]) => ad !== 'İstanbul' && ad !== 'UTC')
            .map(([ad, dilim]) => {
              const p = dilimdeParcala(baslangic, dilim);
              return `  ${ad.padEnd(14)} ${String(p.gun).padStart(2, '0')}.${String(p.ay).padStart(2, '0')} ` +
                `${String(p.saat).padStart(2, '0')}:${String(p.dakika).padStart(2, '0')}`;
            })
            .join('\n') +
          `\n\nEtkilenen servisler : (doldurun)\n` +
          `Beklenen kesinti    : (doldurun)\n` +
          `Geri alma planı     : (doldurun)\n` +
          `İletişim            : (doldurun)`;
      }

      document
        .querySelectorAll('#z-baslangic, #z-sure, #z-referans, #z-mesai')
        .forEach((g) => {
          g.addEventListener('input', hesapla);
          g.addEventListener('change', hesapla);
        });

      document.querySelectorAll('.kopyala').forEach((d) => {
        d.addEventListener('click', async () => {
          try {
            await navigator.clipboard.writeText(el(`#${d.dataset.kaynak}`).textContent);
            d.textContent = 'Kopyalandı';
            setTimeout(() => (d.textContent = 'Kopyala'), 1600);
          } catch {
            /* pano izni yoksa kullanıcı elle seçer */
          }
        });
      });

      // Öntanımlı: bir sonraki salı gecesi 02:00
      const t = new Date();
      t.setDate(t.getDate() + ((2 - t.getDay() + 7) % 7 || 7));
      t.setHours(2, 0, 0, 0);
      const iki = (n) => String(n).padStart(2, '0');
      el('#z-baslangic').value =
        `${t.getFullYear()}-${iki(t.getMonth() + 1)}-${iki(t.getDate())}T${iki(t.getHours())}:${iki(t.getMinutes())}`;

      hesapla();
    })();
  </script>

  <style>
    .z-kaydir {
      overflow-x: auto;
    }
    .z-tablo {
      width: 100%;
      border-collapse: collapse;
      font-size: 13px;
      min-width: 560px;
    }
    .z-tablo th,
    .z-tablo td {
      text-align: left;
      padding: 9px 12px;
      border-bottom: 1px solid var(--line);
      white-space: nowrap;
    }
    .z-tablo th {
      color: var(--muted);
      font-size: 11.5px;
      text-transform: uppercase;
      letter-spacing: 0.04em;
    }
    .z-tablo td:nth-child(2),
    .z-tablo td:nth-child(3),
    .z-tablo td:nth-child(4) {
      font-family: var(--mono, ui-monospace, monospace);
      font-size: 12.5px;
    }
    .z-tablo tr[data-durum='mesai'] {
      background: light-dark(#fef2f2, #2a1616);
    }
    .z-tablo tr[data-durum='mesai'] td:last-child {
      color: light-dark(#991b1b, #fca5a5);
      font-weight: 600;
    }
    .z-tablo tr[data-durum='haftasonu'] td:last-child {
      color: var(--muted);
    }
    .z-tablo tr[data-durum='uygun'] td:last-child {
      color: light-dark(#166534, #6ee7b7);
    }
    .z-liste,
    .z-ipuclari {
      list-style: none;
      margin: 0;
      padding: 0;
      display: grid;
      gap: 12px;
    }
    .z-liste li,
    .z-ipuclari li {
      font-size: 13.5px;
      line-height: 1.62;
      color: var(--ink-soft);
      border-left: 2px solid var(--line);
      padding-left: 13px;
    }
    .z-liste li[data-tip='hata'] {
      border-left-color: light-dark(#dc2626, #f87171);
    }
    .z-liste li[data-tip='uyari'] {
      border-left-color: light-dark(#f0c33c, #a97f1c);
    }
    .z-liste li[data-tip='ok'] {
      border-left-color: light-dark(#16a34a, #4ade80);
    }
  </style>
</Base>
