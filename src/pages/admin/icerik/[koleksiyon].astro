---
import Yonetim from '../../../layouts/Yonetim.astro';
import { KOLEKSIYONLAR, koleksiyonBul, frontmatterAyir } from '../../../admin/icerik';
import { dizinListele, dosyaOku } from '../../../admin/depo';

export const prerender = false;

const slug = Astro.params.koleksiyon!;
const koleksiyon = koleksiyonBul(slug);
if (!koleksiyon) return Astro.redirect('/admin');

let hata: string | null = null;
let kayitlar: { ad: string; baslik: string; taslak: boolean; yayin: string; konu: string }[] = [];

try {
  const adlar = (await dizinListele(koleksiyon.dizin)).filter((a) => a.endsWith(koleksiyon.uzanti));
  kayitlar = await Promise.all(
    adlar.map(async (ad) => {
      try {
        const { icerik } = await dosyaOku(`${koleksiyon.dizin}/${ad}`);
        const { yaml } = frontmatterAyir(icerik);
        return {
          ad,
          baslik: yaml.match(/^baslik:[ \t]*(.*)$/m)?.[1]?.replace(/^["']|["']$/g, '') ?? ad,
          taslak: /^taslak:[ \t]*true/m.test(yaml),
          yayin: yaml.match(/^yayin:[ \t]*(.*)$/m)?.[1]?.trim() ?? '',
          konu: yaml.match(/^konu:[ \t]*(.*)$/m)?.[1]?.trim().replace(/^["']|["']$/g, '') ?? '',
        };
      } catch {
        return { ad, baslik: ad, taslak: false, yayin: '', konu: '' };
      }
    })
  );
  kayitlar.sort((a, b) => (b.yayin || '').localeCompare(a.yayin || '') || a.baslik.localeCompare(b.baslik, 'tr'));
} catch (e) {
  hata = e instanceof Error ? e.message : 'Liste okunamadı.';
}

// Süzgeç kutuları yalnızca işe yarayacaksa gösteriliyor
const konular = [...new Set(kayitlar.map((k) => k.konu).filter(Boolean))].sort((a, b) =>
  a.localeCompare(b, 'tr')
);
const taslakVar = kayitlar.some((k) => k.taslak);
---

<Yonetim baslik={koleksiyon.ad}>
  <section class="y-blok">
    <div style="display:flex;align-items:center;gap:14px;flex-wrap:wrap;margin-bottom:6px">
      <h2 style="margin:0;flex:1">{koleksiyon.ad} <span style="color:var(--muted);font-weight:400">· {kayitlar.length}</span></h2>
      <a class="y-dg" href={`/admin/duzenle?koleksiyon=${koleksiyon.slug}&yeni=1`}>
        Yeni {koleksiyon.tekil}
      </a>
    </div>
    <p style="color:var(--muted);font-size:13.5px;margin:0 0 18px">{koleksiyon.aciklama}</p>

    {hata && <div class="y-kutu kotu">{hata}</div>}

    {
      !hata && kayitlar.length > 0 && (
        <div class="y-suzgec">
          <input
            id="k-ara"
            type="search"
            placeholder={`${kayitlar.length} kayıt içinde ara: başlık, dosya adı, konu…`}
            aria-label="Kayıtlarda ara"
            autocomplete="off"
          />
          {konular.length > 1 && (
            <select id="k-konu" aria-label="Konuya göre süz">
              <option value="">Tüm konular</option>
              {konular.map((k) => (
                <option value={k}>{k}</option>
              ))}
            </select>
          )}
          {taslakVar && (
            <label class="k-onay">
              <input type="checkbox" id="k-taslak" />
              Yalnızca taslaklar
            </label>
          )}
          <span class="k-sayi" id="k-sayi" role="status" aria-live="polite" />
        </div>
      )
    }

    {
      !hata && (
        <div class="y-liste" id="k-liste">
          {kayitlar.map((k) => (
            <a
              class="y-satir"
              href={`/admin/duzenle?koleksiyon=${koleksiyon.slug}&ad=${encodeURIComponent(k.ad)}`}
              data-ara={`${k.baslik} ${k.ad} ${k.konu}`.toLocaleLowerCase('tr')}
              data-konu={k.konu}
              data-taslak={k.taslak ? 'evet' : 'hayir'}
            >
              <b>{k.baslik}</b>
              {k.taslak && <span class="y-etiket taslak">taslak</span>}
              {k.konu && <span class="y-etiket">{k.konu}</span>}
              {k.yayin && <code>{k.yayin}</code>}
              <code>{k.ad}</code>
            </a>
          ))}
        </div>
      )
    }

    {!hata && kayitlar.length === 0 && <div class="y-kutu">Bu koleksiyonda henüz kayıt yok.</div>}
    <div class="y-kutu" id="k-bos" hidden>Süzgece uyan kayıt yok.</div>
  </section>

  <section class="y-blok">
    <h2>Diğer koleksiyonlar</h2>
    <div class="y-dugmeler">
      {
        KOLEKSIYONLAR.filter((k) => k.slug !== koleksiyon.slug).map((k) => (
          <a class="y-dg ikincil" href={`/admin/icerik/${k.slug}`}>
            {k.ad}
          </a>
        ))
      }
    </div>
  </section>

  <script>
    (() => {
      const liste = document.getElementById('k-liste');
      if (!liste) return;
      const ara = document.getElementById('k-ara');
      const konu = document.getElementById('k-konu');
      const taslak = document.getElementById('k-taslak');
      const sayi = document.getElementById('k-sayi');
      const bos = document.getElementById('k-bos');
      const satirlar = [...liste.querySelectorAll('.y-satir')];

      function suz() {
        // Türkçe küçültme: "İPUCU" araması "ipucu" ile eşleşsin
        const q = (ara?.value ?? '').trim().toLocaleLowerCase('tr');
        const k = konu?.value ?? '';
        const yalnizTaslak = taslak?.checked ?? false;
        let gorunen = 0;

        for (const satir of satirlar) {
          const uyar =
            (!q || satir.dataset.ara.includes(q)) &&
            (!k || satir.dataset.konu === k) &&
            (!yalnizTaslak || satir.dataset.taslak === 'evet');
          satir.hidden = !uyar;
          if (uyar) gorunen++;
        }

        if (sayi) sayi.textContent = gorunen === satirlar.length ? `${gorunen} kayıt` : `${gorunen} / ${satirlar.length}`;
        if (bos) bos.hidden = gorunen > 0;
      }

      ara?.addEventListener('input', suz);
      konu?.addEventListener('change', suz);
      taslak?.addEventListener('change', suz);
      // "/" arama kutusuna odaklanır — listede gezerken elini klavyeden çekmesin
      addEventListener('keydown', (e) => {
        if (e.key === '/' && document.activeElement?.tagName !== 'INPUT') {
          e.preventDefault();
          ara?.focus();
        }
      });
      suz();
    })();
  </script>

  <style>
    .y-suzgec {
      display: flex;
      gap: 10px;
      flex-wrap: wrap;
      align-items: center;
      margin-bottom: 14px;
    }
    .y-suzgec input[type='search'] {
      flex: 1 1 260px;
      min-width: 0;
    }
    .k-onay {
      display: flex;
      align-items: center;
      gap: 7px;
      font-size: 13px;
      color: var(--ink-soft);
      cursor: pointer;
      white-space: nowrap;
    }
    .k-onay input {
      width: 16px;
      height: 16px;
      accent-color: var(--indigo);
    }
    .k-sayi {
      font-family: var(--mono);
      font-size: 12px;
      color: var(--muted);
      margin-left: auto;
    }
  </style>
</Yonetim>
