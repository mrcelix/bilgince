---
import Base from '../layouts/Base.astro';
import { getCollection, render } from 'astro:content';
import { SITE } from '../site.js';
import { SSS } from '../cv.js';

/* Sayfanın yazıları `sayfalar` koleksiyonunda: kısa başlık ve düğme yazıları
   ön bilgide, anlatı gövdede. Panelde gövde editörüyle düzenleniyor. */
const sayfa = (await getCollection('sayfalar')).find((s) => s.id === 'hakkimda')!;
const m = sayfa.data;
const { Content } = await render(sayfa);

/* Üçlü kutunun ikonları: metin panelden değişebilsin diye ayrı duruyorlar.
   Kartların sırasıyla eşleşir. */
const UC_IKON = [
  '<svg width="17" height="17" viewBox="0 0 18 18" fill="none"><rect x="2.5" y="2.5" width="13" height="13" rx="2.4" stroke="currentColor" stroke-width="1.5"></rect><path d="M5.5 8L7.5 10l-2 2M10 12h3" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path></svg>',
  '<svg width="17" height="17" viewBox="0 0 18 18" fill="none"><path d="M9 2.5l1.9 4 4.4.6-3.2 3.1.8 4.3L9 12.5l-3.9 2 .8-4.3L2.7 7.1l4.4-.6L9 2.5z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"></path></svg>',
  '<svg width="17" height="17" viewBox="0 0 18 18" fill="none"><circle cx="9" cy="9" r="6.5" stroke="currentColor" stroke-width="1.5"></circle><path d="M9 5.5v4l2.5 1.6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path></svg>',
];
---

<Base
  kategori="Sayfa"
  baslik="Hakkımda"
  aciklama={m.ozet}
  tur="profile"
  ogGorsel="/og/sayfa-hakkimda.png"
  jsonLd={[
    {
      '@context': 'https://schema.org',
      '@type': 'ProfilePage',
      mainEntity: {
        '@type': 'Person',
        name: SITE.author.name,
        jobTitle: SITE.author.jobTitle,
        worksFor: { '@type': 'Organization', name: SITE.author.worksFor },
        address: { '@type': 'PostalAddress', addressLocality: SITE.author.location },
        email: `mailto:${SITE.author.email}`,
        url: `${SITE.url}/hakkimda`,
        sameAs: [SITE.author.linkedin, SITE.author.github],
        knowsAbout: SITE.author.knowsAbout,
      },
    },
    {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: SSS.map((s) => ({
        '@type': 'Question',
        name: s.soru,
        acceptedAnswer: { '@type': 'Answer', text: s.cevap },
      })),
    },
  ]}
>
  <div class="kap">
    <section class="tanitim-duzen">
      <div class="portre">
        <span class="yuz" aria-hidden="true">{SITE.author.initials}</span>
        <div>
          <span class="ad">{SITE.author.name}</span>
          <span class="unvan">{SITE.author.jobTitle} · {SITE.author.location}</span>
        </div>
        <span class="yetenekler">
          {SITE.author.knowsAbout.map((y) => <span>{y}</span>)}
        </span>
      </div>

      <div>
        <span class="rozet"><i></i>{m.rozet}</span>
        <h1>{m.baslik}</h1>
        <div class="anlati"><Content /></div>
        <div class="eylemler" style="display:flex;gap:12px;margin-top:26px;flex-wrap:wrap">
          {
            m.dugmeler.map((d) => (
              <a class={d.ikincil ? 'dg dg-hayalet' : 'dg'} href={d.adres}>
                {d.yazi}
              </a>
            ))
          }
        </div>
      </div>
    </section>

    <section class="uc-kutu">
      {
        /* İkonlar sabit; başlık ve metin ön bilgiden geliyor. Sıra kartların
           sırasıyla eşleşiyor. */
        m.kartlar.map((k, i) => (
          <div>
            <span class="ikon" aria-hidden="true" set:html={UC_IKON[i] ?? UC_IKON[0]} />
            <h3>{k.baslik}</h3>
            <p>{k.metin}</p>
          </div>
        ))
      }
    </section>

    <section class="bolum">
      <div class="bolum-bas"><div><h2>{m.bolumBasliklari.sss}</h2></div></div>
      <div class="sss">
        {
          SSS.map((s) => (
            <div>
              <h3>{s.soru}</h3>
              <p>{s.cevap}</p>
            </div>
          ))
        }
      </div>
    </section>

    <section class="bolum" id="iletisim">
      <div class="bolum-bas">
        <div>
          <h2>{m.bolumBasliklari.iletisim}</h2>
          <p>{m.bolumBasliklari.iletisimAciklama}</p>
        </div>
      </div>
      <div class="kanallar">
        <a class="kanal" href={`mailto:${SITE.author.email}`}>
          <span class="ikon" aria-hidden="true">
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none"
              ><rect x="2" y="3.5" width="12" height="9" rx="1.8" stroke="currentColor" stroke-width="1.6"
              ></rect><path d="M2.6 4.6L8 8.6l5.4-4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"
                stroke-linejoin="round"></path></svg
            >
          </span>
          <span>
            <span class="ad">E-posta</span>
            <span class="ac">{SITE.author.email} · {m.kanalAciklamalari.eposta}</span>
          </span>
        </a>
        <a class="kanal" href={SITE.author.linkedin} rel="me noopener">
          <span class="ikon" aria-hidden="true">
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none"
              ><rect x="2.5" y="2.5" width="11" height="11" rx="2" stroke="currentColor" stroke-width="1.5"
              ></rect><path
                d="M5.2 6.8v4M5.2 5.1v.01M8 10.8V8.4a1.5 1.5 0 013 0v2.4"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"></path></svg
            >
          </span>
          <span>
            <span class="ad">LinkedIn</span>
            <span class="ac">{m.kanalAciklamalari.linkedin}</span>
          </span>
        </a>
        <a class="kanal" href={SITE.author.github} rel="me noopener">
          <span class="ikon" aria-hidden="true">
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none"
              ><path d="M3 4.5L6 8l-3 3.5M8 11.5h5" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"
                stroke-linejoin="round"></path></svg
            >
          </span>
          <span>
            <span class="ad">GitHub</span>
            <span class="ac">{m.kanalAciklamalari.github}</span>
          </span>
        </a>
      </div>
    </section>
  </div>
</Base>
