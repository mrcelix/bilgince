---
/**
 * Seri dizini. Seri sayfaları vardı ama listeleri yoktu: bir seriyi ancak
 * bölümlerinden birine denk gelirseniz keşfedebiliyordunuz. Kök adres de
 * 404 dönüyordu.
 */
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { SITE, KONULAR, slugla, trTarih } from '../../site.js';

const rehberler = (await getCollection('rehberler')).filter((r) => !r.data.taslak);
const adlar = [...new Set(rehberler.map((r) => r.data.seri).filter(Boolean))] as string[];

const seriler = adlar
  .map((ad) => {
    const bolumler = rehberler
      .filter((r) => r.data.seri === ad)
      .sort((a, b) => (a.data.seriSira ?? 99) - (b.data.seriSira ?? 99));
    return {
      ad,
      slug: slugla(ad),
      bolumler,
      // Sıra numarası dizideki en büyük değer; eksik bölümler bundan anlaşılıyor
      planlanan: Math.max(...bolumler.map((b) => b.data.seriSira ?? 0), bolumler.length),
      sure: bolumler.reduce((t, b) => t + b.data.sure, 0),
      enSon: bolumler.map((b) => b.data.guncelleme ?? b.data.yayin).sort((a, b) => +b - +a)[0],
      konu: bolumler[0]?.data.konu,
    };
  })
  .sort((a, b) => +b.enSon - +a.enSon);

const konuAdi = (k?: string) => KONULAR.find((x) => x.slug === k)?.ad ?? k ?? '';
const toplamBolum = seriler.reduce((t, s) => t + s.bolumler.length, 0);
---

<Base
  baslik="Seriler"
  aciklama={`Sırayla okunmak üzere yazılmış ${seriler.length} rehber serisi, toplam ${toplamBolum} bölüm.`}
  kategori="Sayfa"
  jsonLd={{
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: 'Seriler',
    url: `${SITE.url}/seri`,
    inLanguage: 'tr-TR',
    numberOfItems: seriler.length,
  }}
>
  <div class="arama-bas">
    <div class="kap">
      <nav class="kirinti" aria-label="Kırıntı yolu" style="padding-top:0">
        <a href="/">Ana sayfa</a><span class="ayrac">/</span><span aria-current="page">Seriler</span>
      </nav>
      <h1>Seriler</h1>
      <p style="color:var(--muted);font-size:14px;margin-top:8px;max-width:66ch">
        Tek yazıya sığmayan konular. Bölümler sırayla okunmak üzere yazıldı; her biri kendi başına
        da işe yarıyor ama sıra takip edildiğinde bir kurulum baştan sona çıkıyor.
      </p>
    </div>
  </div>

  <div class="kap" style="padding-bottom:64px">
    <div class="seri-liste">
      {
        seriler.map((s) => (
          <article class="uclu-kart seri-kart">
            <span class="etiket">{konuAdi(s.konu)}</span>
            <h2>
              <a href={`/seri/${s.slug}`}>{s.ad}</a>
            </h2>
            <p>
              {s.bolumler.length} bölüm yayında
              {s.planlanan > s.bolumler.length && ` · ${s.planlanan} bölüm planlandı`} · toplam {s.sure} dk
            </p>
            <ol class="seri-bolumler">
              {s.bolumler.map((b) => (
                <li>
                  <a href={`/rehberler/${b.id}`}>{b.data.baslik}</a>
                  <span>{b.data.sure} dk</span>
                </li>
              ))}
            </ol>
            <span class="seri-alt">Son güncelleme {trTarih(s.enSon)}</span>
          </article>
        ))
      }
    </div>
  </div>
</Base>

<style>
  .seri-liste {
    display: grid;
    gap: 20px;
    padding-top: 28px;
    grid-template-columns: repeat(auto-fit, minmax(min(320px, 100%), 1fr));
  }
  .seri-kart h2 {
    font-size: 19px;
    font-weight: 900;
    letter-spacing: -0.03em;
    line-height: 1.2;
  }
  .seri-kart h2 a:hover {
    color: var(--indigo-metin);
  }
  .seri-kart > p {
    font-size: 13px;
    color: var(--muted);
  }
  .seri-bolumler {
    list-style: none;
    margin: 4px 0 0;
    padding: 0 0 0 14px;
    border-left: 2px solid var(--line);
    display: grid;
    gap: 8px;
    counter-reset: bolum;
  }
  .seri-bolumler li {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    font-size: 13.5px;
  }
  .seri-bolumler li::before {
    counter-increment: bolum;
    content: counter(bolum) '.';
    font-family: var(--mono);
    font-size: 11.5px;
    color: var(--muted);
  }
  .seri-bolumler a {
    flex: 1;
    font-weight: 700;
    line-height: 1.4;
  }
  .seri-bolumler a:hover {
    color: var(--indigo-metin);
  }
  .seri-bolumler span {
    font-family: var(--mono);
    font-size: 11px;
    color: var(--muted);
    white-space: nowrap;
  }
  .seri-alt {
    margin-top: auto;
    padding-top: 6px;
    font-size: 11.5px;
    color: var(--muted);
  }
</style>
