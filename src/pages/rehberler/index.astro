---
import Base from '../../layouts/Base.astro';
import ArsivIcerik from '../../components/ArsivIcerik.astro';
import { getCollection } from 'astro:content';
import { SITE, SAYFA_BASI } from '../../site.js';

const hepsi = (await getCollection('rehberler'))
  .filter((r) => !r.data.taslak)
  .sort((a, b) => +b.data.yayin - +a.data.yayin);

const toplamSayfa = Math.max(1, Math.ceil(hepsi.length / SAYFA_BASI));
const dilim = hepsi.slice(0, SAYFA_BASI);
---

<Base
  aramaya={false}
  baslik="Tüm rehberler"
  aciklama={`Windows Server, PowerShell, ağ ve güvenlik üzerine ${hepsi.length} rehber. Her biri üretim ortamında denendi.`}
  ogGorsel="/og/sayfa-rehberler.png"
  jsonLd={{
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: 'Tüm rehberler',
    url: `${SITE.url}/rehberler`,
    numberOfItems: hepsi.length,
  }}
>
  <ArsivIcerik hepsi={hepsi} dilim={dilim} simdiki={1} toplamSayfa={toplamSayfa} />
</Base>
