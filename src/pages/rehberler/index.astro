---
import Base from '../../layouts/Base.astro';
import Satir from '../../components/Satir.astro';
import { getCollection } from 'astro:content';
import { KONULAR, SITE, trTarih } from '../../site.js';

const rehberler = (await getCollection('rehberler'))
  .filter((r) => !r.data.taslak)
  .sort((a, b) => +b.data.yayin - +a.data.yayin);

const ortalama = Math.round(rehberler.reduce((t, r) => t + r.data.sure, 0) / rehberler.length);
const seriler = [...new Set(rehberler.map((r) => r.data.seri).filter(Boolean))] as string[];
const sonGuncelleme = rehberler.map((r) => r.data.guncelleme ?? r.data.yayin).sort((a, b) => +b - +a)[0];
---

<Base
  baslik="Tüm rehberler"
  aciklama={`Windows Server, PowerShell, ağ ve güvenlik üzerine ${rehberler.length} rehber. Her biri üretim ortamında denendi.`}
  jsonLd={{
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: 'Tüm rehberler',
    url: `${SITE.url}/rehberler`,
    numberOfItems: rehberler.length,
  }}
>
  <div class="lavanta">
    <div class="kap">
      <nav class="kirinti" aria-label="Kırıntı yolu">
        <a href="/">Ana sayfa</a><span class="ayrac">/</span><span aria-current="page">Rehberler</span>
      </nav>
      <div class="konu-bas" style="padding-top:8px">
        <span class="etiket">Arşiv</span>
        <h1>Tüm rehberler</h1>
        <p class="ozet">
          Her rehber tek bir görevi baştan sona bitirir. Komutlar üretim ortamında denendi ve her yazının
          sonunda çalıştığını doğrulayacağınız bir adım var.
        </p>
        <div class="konu-sayac">
          <span><b>{rehberler.length}</b> rehber</span>
          <span><b>{seriler.length}</b> seri</span>
          <span>Ortalama <b>{ortalama} dk</b> okuma</span>
          <span>Son güncelleme <b>{trTarih(sonGuncelleme)}</b></span>
        </div>
      </div>
    </div>
  </div>

  <div class="suzgec">
    <div class="kap">
      <a class="cip" href="/rehberler" aria-current="page">Tümü <span style="opacity:.7">{rehberler.length}</span></a>
      {
        KONULAR.map((k) => {
          const n = rehberler.filter((r) => r.data.konu === k.slug).length;
          return n > 0 ? (
            <a class="cip" href={`/konu/${k.slug}`}>
              {k.ad} <span style="opacity:.6">{n}</span>
            </a>
          ) : null;
        })
      }
    </div>
  </div>

  <div class="kap">
    <div class="arsiv">
      <div class="liste">
        {
          rehberler.map((r) => (
            <Satir
              href={`/rehberler/${r.id}`}
              baslik={r.data.baslik}
              ozet={r.data.ozet}
              tarih={r.data.yayin}
              sure={r.data.sure}
              etiketler={r.data.etiketler}
            />
          ))
        }
      </div>

      <aside class="yan">
        {
          seriler.map((s) => {
            const bolumler = rehberler.filter((r) => r.data.seri === s);
            return (
              <div class="seri-kutu">
                <span class="yan-etiket">Seri</span>
                <h3>{s}</h3>
                <span class="ilerleme">
                  <span style={`width:${Math.min(100, bolumler.length * 20)}%`} />
                </span>
                <span style="font-size:12px;color:var(--muted);font-weight:600">
                  {bolumler.length} bölüm yayında
                </span>
              </div>
            );
          })
        }
        <div class="yan-tanitim">
          <h3>Haftada bir teknik not</h3>
          <p>Yeni rehberler ve komut kütüphanesi girdileri e-postayla.</p>
          <a class="dg" href="/#bulten">Bültene katıl</a>
        </div>
      </aside>
    </div>
  </div>
</Base>
