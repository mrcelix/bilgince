---
import { getCollection } from 'astro:content';
import KonuIkon from './KonuIkon.astro';
import Tema from './Tema.astro';
import { SITE, KONULAR, GRUPLAR, POPULER_ARAMALAR, slugla, sayi } from '../site.js';
import { ARACLAR } from '../araclar.js';

const rehberler = (await getCollection('rehberler')).filter((r) => !r.data.taslak);
const ipuclari = await getCollection('ipuclari');
const komutlar = await getCollection('komutlar');
const cozumler = await getCollection('cozumler');

const say = (slug: string) =>
  rehberler.filter((r) => r.data.konu === slug).length +
  ipuclari.filter((i) => i.data.konu === slug).length;

const oneCikan =
  rehberler.find((r) => r.data.oneCikan) ??
  [...rehberler].sort((a, b) => +b.data.yayin - +a.data.yayin)[0];

const seriler = [...new Set(rehberler.map((r) => r.data.seri).filter(Boolean))].map((ad) => {
  const bolumler = rehberler.filter((r) => r.data.seri === ad);
  const planlanan = Math.max(...bolumler.map((b) => b.data.seriSira ?? 0), bolumler.length);
  return { ad: ad as string, yayinda: bolumler.length, planlanan };
});

// Öne çıkan konular küme sütunlarından çıkarılıp menünün üstünde tam genişlik
// bir şeride alınıyor; böylece sütun sayısı da kontrolde kalıyor.
const oneCikanKonular = KONULAR.filter((k) => k.oneCikan);
const gorunenGruplar = GRUPLAR.filter((g) =>
  KONULAR.some((k) => k.grup === g.ad && !k.oneCikan)
);

// Araçlar menüsü: indirilebilir betikler tek tek elle yazılmıyor, çözüm
// kayıtlarındaki `dosya` alanından türüyor — yeni betik eklenince menü kendi
// kendine büyür.
const betikler = cozumler
  .filter((c) => c.data.dosya)
  .sort((a, b) => a.data.sira - b.data.sira);

/* Araçlar kütükteki `grup` alanına göre öbeklenir. Liste artık kırpılmıyor:
   panel içindeki süzgeç kutusu ve kendi kaydırma alanı sayesinde araç sayısı
   büyüdükçe menü kullanılamaz hâle gelmiyor. */
const aracGruplari = [...new Set(ARACLAR.map((a) => a.grup ?? 'Diğer'))].map((ad) => ({
  ad,
  araclar: ARACLAR.filter((a) => (a.grup ?? 'Diğer') === ad),
}));

// Betikler konuya göre öbekleniyor; 25+ betik tek sütunda okunmuyordu.
const betikGruplari = [...new Set(betikler.map((b) => b.data.konu))].map((slug) => ({
  ad: KONULAR.find((k) => k.slug === slug)?.ad ?? slug,
  betikler: betikler.filter((b) => b.data.konu === slug),
}));

const yol = Astro.url.pathname.replace(/\/$/, '') || '/';
const etkin = (p: string) => (yol === p || yol.startsWith(p + '/') ? 'page' : undefined);
---

<div class="ust-serit">
  <div class="kap">
    <span class="sol">
      <span class="canli"
        ><i></i>{SITE.newsletter.cadence} · <b>{sayi(SITE.newsletter.subscribers)} abone</b></span
      >
      <span class="gizle-dar">{rehberler.length} rehber · {ipuclari.length} ipucu · {komutlar.length} komut</span>
    </span>
    <span class="sag">
      <a href="/rss.xml">RSS</a>
      <a href={SITE.author.github} rel="me noopener">GitHub</a>
      <a href={SITE.author.linkedin} rel="me noopener">LinkedIn</a>
      <a href="/hakkimda#iletisim">İletişim</a>
    </span>
  </div>
</div>

<header class="bas">
  <div class="kap">
    <a class="logo" href="/" aria-label={`${SITE.name} ana sayfa`}>{SITE.name}</a>

    <nav aria-label="Ana menü" style="display:contents">
      <ul class="gez">
        <li>
          <button class="gez-bag" type="button" aria-expanded="false" aria-controls="mega-konular" data-mega="konular">
            Konular
            <svg class="ok" width="11" height="11" viewBox="0 0 12 12" fill="none" aria-hidden="true"
              ><path d="M3 4.5L6 7.5L9 4.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path></svg
            >
          </button>
        </li>
        <li>
          <button class="gez-bag" type="button" aria-expanded="false" aria-controls="mega-kaynaklar" data-mega="kaynaklar">
            Kaynaklar
            <svg class="ok" width="11" height="11" viewBox="0 0 12 12" fill="none" aria-hidden="true"
              ><path d="M3 4.5L6 7.5L9 4.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path></svg
            >
          </button>
        </li>
        <li>
          <button class="gez-bag" type="button" aria-expanded="false" aria-controls="mega-araclar" data-mega="araclar">
            Araçlar
            <svg class="ok" width="11" height="11" viewBox="0 0 12 12" fill="none" aria-hidden="true"
              ><path d="M3 4.5L6 7.5L9 4.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path></svg
            >
          </button>
        </li>
        <li><a class="gez-bag" href="/portfolyo" aria-current={etkin('/portfolyo')}>Portfolyo</a></li>
        <li><a class="gez-bag" href="/ozgecmis" aria-current={etkin('/ozgecmis')}>Özgeçmiş</a></li>
        <li><a class="gez-bag" href="/hakkimda" aria-current={etkin('/hakkimda')}>Hakkımda</a></li>
      </ul>
    </nav>

    <a class="ara-kutu" href="/ara">
      <svg width="13" height="13" viewBox="0 0 14 14" fill="none" aria-hidden="true"
        ><circle cx="6.2" cy="6.2" r="4.2" stroke="currentColor" stroke-width="1.6"></circle><path
          d="M9.4 9.4L12 12"
          stroke="currentColor"
          stroke-width="1.6"
          stroke-linecap="round"></path></svg
      >
      Ara
      <kbd class="ara-kisayol">Ctrl K</kbd>
    </a>
    <Tema />
    <a class="dg" href="/#bulten">Bültene katıl</a>

    <button class="hamburger" type="button" aria-label="Menüyü aç" aria-expanded="false" data-cekmece-ac>
      <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true"
        ><path d="M3 5h12M3 9h12M3 13h12" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"></path></svg
      >
    </button>
  </div>

  <!-- ------------------------------------------------ Konular mega menüsü -->
  <div class="mega mega-genis" id="mega-konular" data-acik="hayir">
    <div class="mega-ust">
      <div class="kap">
        <label class="mega-ara">
          <svg width="13" height="13" viewBox="0 0 14 14" fill="none" aria-hidden="true">
            <circle cx="6.2" cy="6.2" r="4.2" stroke="currentColor" stroke-width="1.6"></circle>
            <path d="M9.4 9.4L12 12" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path>
          </svg>
          <input
            type="search"
            placeholder="Konularda süz: kubernetes, yedekleme, entra…"
            aria-label="Konularda süz"
            autocomplete="off"
            data-mega-suzgec="konular"
          />
        </label>
        <span class="mega-sayac" data-mega-sayac="konular"></span>
        <a class="mega-tum" href="/rehberler">Tüm arşiv · {rehberler.length} rehber →</a>
      </div>
    </div>

    <div class="mega-govde" data-mega-kap="konular">
      {
        oneCikanKonular.length > 0 && (
          <div class="kap mega-one-serit" data-mega-obek>
            {oneCikanKonular.map((k) => (
              <a class="one-cikan-konu" href={`/konu/${k.slug}`} data-mega-oge={`${k.ad} ${k.ozet}`}>
                <span class="ikon" aria-hidden="true">
                  <KonuIkon ad={k.ikon} />
                </span>
                <span class="govde">
                  <span class="ad">
                    {k.ad}
                    <span class="say">{say(k.slug)}</span>
                  </span>
                  <span class="ac">{k.ozet}</span>
                </span>
              </a>
            ))}
          </div>
        )
      }

      <div class="kap mega-izgara">
        {
          GRUPLAR.filter((g) => KONULAR.some((k) => k.grup === g.ad)).map((grup) => (
            <div class="mega-obek" data-mega-obek>
              <span class="mega-etiket">{grup.ad}</span>
              <span class="mega-grup-ozet">{grup.ozet}</span>
              {KONULAR.filter((k) => k.grup === grup.ad).map((k) => (
                <a class="mega-sik" href={`/konu/${k.slug}`} data-mega-oge={`${k.ad} ${k.ozet} ${grup.ad}`}>
                  <span class="ikon" aria-hidden="true">
                    <KonuIkon ad={k.ikon} />
                  </span>
                  <span class="govde">
                    <span class="ad">
                      {k.ad}
                      <span class="say">{say(k.slug)}</span>
                    </span>
                    <span class="ac">{k.ozet}</span>
                  </span>
                </a>
              ))}
            </div>
          ))
        }
      </div>

      <p class="mega-bos" data-mega-bos="konular" hidden>Bu süzgece uyan konu yok.</p>
    </div>
  </div>

  <!-- ---------------------------------------------- Kaynaklar mega menüsü -->
  <div class="mega mega-genis" id="mega-kaynaklar" data-acik="hayir">
    <div class="mega-ust">
      <div class="kap">
        <label class="mega-ara">
          <svg width="13" height="13" viewBox="0 0 14 14" fill="none" aria-hidden="true">
            <circle cx="6.2" cy="6.2" r="4.2" stroke="currentColor" stroke-width="1.6"></circle>
            <path d="M9.4 9.4L12 12" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path>
          </svg>
          <input
            type="search"
            placeholder="Kaynaklarda süz: seri, etiket, ipucu…"
            aria-label="Kaynaklarda süz"
            autocomplete="off"
            data-mega-suzgec="kaynaklar"
          />
        </label>
        <span class="mega-sayac" data-mega-sayac="kaynaklar"></span>
        <a class="mega-tum" href="/ara">Gelişmiş arama →</a>
      </div>
    </div>

    <div class="mega-govde" data-mega-kap="kaynaklar">
      <div class="kap mega-izgara">
        <div class="mega-obek" data-mega-obek>
          <span class="mega-etiket">Kütüphaneler</span>
          <span class="mega-grup-ozet">Kopyala ve çalıştır</span>
          <a class="mega-sik" href="/hizli-cozumler" data-mega-oge="Hızlı Çözümler belirti">
            <span class="ikon" aria-hidden="true"><KonuIkon ad="kalkan" /></span>
            <span class="govde">
              <span class="ad">Hızlı Çözümler<span class="say">{cozumler.length}</span></span>
              <span class="ac">Belirtiden çözüme, indirilebilir araçlarla</span>
            </span>
          </a>
          <a class="mega-sik" href="/komutlar" data-mega-oge="Komut kütüphanesi">
            <span class="ikon" aria-hidden="true"><KonuIkon ad="terminal" /></span>
            <span class="govde">
              <span class="ad">Komut kütüphanesi<span class="say">{komutlar.length}</span></span>
              <span class="ac">Denenmiş tek satırlar, uyarısıyla birlikte</span>
            </span>
          </a>
          <a class="mega-sik" href="/ipuclari" data-mega-oge="Hızlı ipuçları notlar">
            <span class="ikon" aria-hidden="true"><KonuIkon ad="pencere" /></span>
            <span class="govde">
              <span class="ad">Hızlı ipuçları<span class="say">{ipuclari.length}</span></span>
              <span class="ac">Tek ekranda biten notlar</span>
            </span>
          </a>
          <a class="mega-sik" href="/rehberler" data-mega-oge="Rehberler arşiv">
            <span class="ikon" aria-hidden="true"><KonuIkon ad="kutu" /></span>
            <span class="govde">
              <span class="ad">Rehberler<span class="say">{rehberler.length}</span></span>
              <span class="ac">Uzun anlatım, sonunda doğrulama adımı</span>
            </span>
          </a>
        </div>

        <div class="mega-obek" data-mega-obek>
          <span class="mega-etiket">Gezinme</span>
          <span class="mega-grup-ozet">İçeriği kesen yollar</span>
          <a class="mega-sik" href="/tani" data-mega-oge="Tanı sihirbazı belirti">
            <span class="ikon" aria-hidden="true"><KonuIkon ad="dugum" /></span>
            <span class="govde">
              <span class="ad">Tanı sihirbazı</span>
              <span class="ac">Belirtiyi seç, çözüme git</span>
            </span>
          </a>
          <a class="mega-sik" href="/seri" data-mega-oge="Seriler bölüm">
            <span class="ikon" aria-hidden="true"><KonuIkon ad="akis" /></span>
            <span class="govde">
              <span class="ad">Seriler<span class="say">{seriler.length}</span></span>
              <span class="ac">Sırayla okunmak üzere yazıldı</span>
            </span>
          </a>
          <a class="mega-sik" href="/etiket" data-mega-oge="Etiketler bulut">
            <span class="ikon" aria-hidden="true"><KonuIkon ad="dugum" /></span>
            <span class="govde">
              <span class="ad">Etiketler</span>
              <span class="ac">Tüm içeriği kesen ince süzgeçler</span>
            </span>
          </a>
          <a class="mega-sik" href="/rss.xml" data-mega-oge="RSS akışı">
            <span class="ikon" aria-hidden="true"><KonuIkon ad="geri" /></span>
            <span class="govde">
              <span class="ad">RSS akışı</span>
              <span class="ac">Bültene alternatif</span>
            </span>
          </a>
        </div>

        <div class="mega-obek mega-obek-genis" data-mega-obek>
          <span class="mega-etiket">Seriler</span>
          <span class="mega-grup-ozet">Sırayla okunmak üzere</span>
          <div class="mega-seriler">
            {
              seriler.map((s) => (
                <a class="mega-seri" href={`/seri/${slugla(s.ad)}`} data-mega-oge={s.ad}>
                  <span class="ad">{s.ad}</span>
                  <span class="ilerleme">
                    <span style={`width:${Math.round((s.yayinda / Math.max(s.planlanan, 1)) * 100)}%`} />
                  </span>
                  <span class="ac">
                    {s.planlanan} bölümün {s.yayinda} tanesi yayında
                  </span>
                </a>
              ))
            }
          </div>
        </div>
      </div>

      <p class="mega-bos" data-mega-bos="kaynaklar" hidden>Bu süzgece uyan kaynak yok.</p>
    </div>
  </div>

  <!-- ------------------------------------------------- Araçlar mega menüsü -->
  <div class="mega mega-genis" id="mega-araclar" data-acik="hayir">
    <div class="mega-ust">
      <div class="kap">
        <label class="mega-ara">
          <svg width="13" height="13" viewBox="0 0 14 14" fill="none" aria-hidden="true">
            <circle cx="6.2" cy="6.2" r="4.2" stroke="currentColor" stroke-width="1.6"></circle>
            <path d="M9.4 9.4L12 12" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path>
          </svg>
          <input
            type="search"
            placeholder="Araçlarda süz: parola, dns, sertifika…"
            aria-label="Araçlarda süz"
            autocomplete="off"
            data-mega-suzgec="araclar"
          />
        </label>
        <span class="mega-sayac" data-mega-sayac="araclar"></span>
        <a class="mega-tum" href="/araclar">Tüm araçlar →</a>
      </div>
    </div>

    <div class="mega-govde" data-mega-kap="araclar">
      <div class="kap mega-izgara">
        {
          aracGruplari.map((g) => (
            <div class="mega-obek" data-mega-obek>
              <span class="mega-etiket">{g.ad}</span>
              {g.araclar.map((a) => (
                <a class="mega-sik" href={`/araclar/${a.slug}`} data-mega-oge={`${a.ad} ${a.ozet} ${a.grup}`}>
                  <span class="ikon" aria-hidden="true">
                    <KonuIkon ad={a.ikon} />
                  </span>
                  <span class="govde">
                    <span class="ad">
                      {a.ad}
                      {a.etiket && <span class="say">{a.etiket}</span>}
                    </span>
                    <span class="ac">{a.ozet}</span>
                  </span>
                </a>
              ))}
            </div>
          ))
        }

        <div class="mega-obek" data-mega-obek>
          <span class="mega-etiket">Kütüphaneler</span>
          <a class="mega-sik" href="/komutlar" data-mega-oge="Komut kütüphanesi kopyala">
            <span class="ikon" aria-hidden="true"><KonuIkon ad="terminal" /></span>
            <span class="govde">
              <span class="ad">Komut kütüphanesi<span class="say">{komutlar.length}</span></span>
              <span class="ac">Konuya göre süz, tek tıkla kopyala</span>
            </span>
          </a>
          <a class="mega-sik" href="/tani" data-mega-oge="Tanı sihirbazı belirti">
            <span class="ikon" aria-hidden="true"><KonuIkon ad="dugum" /></span>
            <span class="govde">
              <span class="ad">Tanı sihirbazı</span>
              <span class="ac">Belirtiyi seç, çözümü bul</span>
            </span>
          </a>
          <a class="mega-sik" href="/canta" data-mega-oge="Saha çantası runbook">
            <span class="ikon" aria-hidden="true"><KonuIkon ad="kutu" /></span>
            <span class="govde">
              <span class="ad">Saha çantası</span>
              <span class="ac">Topladıklarını tek dosyaya çevir</span>
            </span>
          </a>
        </div>
      </div>

      <div class="mega-alt-baslik">
        <div class="kap">
          <span class="mega-etiket">İndirilebilir betikler</span>
          <span class="mega-grup-ozet">
            PowerShell · {betikler.length} betik · değişiklik yapmadan önce okuyun
          </span>
        </div>
      </div>

      <div class="kap mega-izgara">
        {
          betikGruplari.map((g) => (
            <div class="mega-obek" data-mega-obek>
              <span class="mega-etiket ikincil">{g.ad}</span>
              {g.betikler.map((b) => (
                <a
                  class="mega-sik dar"
                  href={`/hizli-cozumler/${b.id}`}
                  data-mega-oge={`${b.data.dosyaAdi ?? ''} ${b.data.baslik}`}
                >
                  <span class="govde">
                    <span class="ad kod">{b.data.dosyaAdi ?? b.data.dosya}</span>
                    <span class="ac">{b.data.baslik}</span>
                  </span>
                </a>
              ))}
            </div>
          ))
        }
      </div>

      <p class="mega-bos" data-mega-bos="araclar" hidden>Bu süzgece uyan araç yok.</p>
    </div>
  </div>

<script>
  const bas = document.querySelector('.bas');
  const dugmeler = [...document.querySelectorAll<HTMLButtonElement>('[data-mega]')];
  const perde = document.getElementById('perde');

  /** Perdenin durumu tek yerden türetiliyor: mega menü ya da çekmeceden biri
      açıksa perde açık. Ayrıca çekmece açıkken perde başlığın da üstüne çıksın
      diye `data-tam` işaretleniyor. */
  function perdeTazele() {
    if (!perde) return;
    const megaAcik = dugmeler.some((d) => d.getAttribute('aria-expanded') === 'true');
    const cekmeceAcik = cekmece?.dataset.acik === 'evet';
    perde.dataset.acik = megaAcik || cekmeceAcik ? 'evet' : 'hayir';
    perde.dataset.tam = cekmeceAcik ? 'evet' : 'hayir';
  }

  function megaAyarla(hangi: string | null) {
    dugmeler.forEach((d) => {
      const acik = d.dataset.mega === hangi;
      d.setAttribute('aria-expanded', String(acik));
      const panel = document.getElementById(d.getAttribute('aria-controls') ?? '');
      if (panel) panel.dataset.acik = acik ? 'evet' : 'hayir';
    });
    perdeTazele();
  }

  /* --- panel içi süzgeç ---------------------------------------------------
     Menü artık her şeyi gösteriyor (23 konu, 25+ araç, 25+ betik). Aramadan
     bulmak zorlaşınca panelin kendi süzgeci devreye giriyor: yazdıkça
     eşleşmeyen satırlar ve boşalan öbekler gizleniyor. */
  const suzgecler = [...document.querySelectorAll<HTMLInputElement>('[data-mega-suzgec]')];

  function panelSuz(girdi: HTMLInputElement) {
    const ad = girdi.dataset.megaSuzgec!;
    const kap = document.querySelector<HTMLElement>(`[data-mega-kap="${ad}"]`);
    if (!kap) return;
    // Türkçe küçültme: "DNS" araması "dns" ile eşleşsin
    const q = girdi.value.trim().toLocaleLowerCase('tr');
    let gorunen = 0;

    kap.querySelectorAll<HTMLElement>('[data-mega-oge]').forEach((oge) => {
      const uyar = !q || (oge.dataset.megaOge ?? '').toLocaleLowerCase('tr').includes(q);
      oge.hidden = !uyar;
      if (uyar) gorunen++;
    });

    // Tamamı gizlenen öbek başlığıyla birlikte kalkıyor
    kap.querySelectorAll<HTMLElement>('[data-mega-obek]').forEach((obek) => {
      const kalan = [...obek.querySelectorAll<HTMLElement>('[data-mega-oge]')].some((o) => !o.hidden);
      obek.hidden = !kalan;
    });

    const sayac = document.querySelector<HTMLElement>(`[data-mega-sayac="${ad}"]`);
    const toplam = kap.querySelectorAll('[data-mega-oge]').length;
    if (sayac) sayac.textContent = q ? `${gorunen} / ${toplam}` : `${toplam} kayıt`;

    const bos = document.querySelector<HTMLElement>(`[data-mega-bos="${ad}"]`);
    if (bos) bos.hidden = gorunen > 0;
  }

  suzgecler.forEach((g) => {
    g.addEventListener('input', () => panelSuz(g));
    // Esc önce süzgeci temizler, menüyü kapatmaz — yazdığını kaybetme
    g.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && g.value) {
        e.stopPropagation();
        g.value = '';
        panelSuz(g);
      }
    });
    panelSuz(g);
  });

  dugmeler.forEach((d) => {
    d.addEventListener('click', () =>
      megaAyarla(d.getAttribute('aria-expanded') === 'true' ? null : (d.dataset.mega ?? null))
    );
    // fareyle üzerine gelince aç — mega menüde beklenen davranış
    d.addEventListener('mouseenter', () => megaAyarla(d.dataset.mega ?? null));
    d.addEventListener('focus', () => megaAyarla(d.dataset.mega ?? null));
  });

  bas?.addEventListener('mouseleave', () => megaAyarla(null));
  document.addEventListener('click', (e) => {
    if (!bas?.contains(e.target as Node)) megaAyarla(null);
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      megaAyarla(null);
      cekmeceAyarla(false);
    }
  });

  const cekmece = document.getElementById('cekmece');
  const acDugme = document.querySelector<HTMLButtonElement>('[data-cekmece-ac]');
  let oncekiOdak: HTMLElement | null = null;

  function odaklanabilirler() {
    return [...(cekmece?.querySelectorAll<HTMLElement>('a[href], button, summary, input') ?? [])].filter(
      (e) => e.offsetParent !== null
    );
  }

  function cekmeceAyarla(acik: boolean) {
    if (!cekmece) return;
    cekmece.dataset.acik = acik ? 'evet' : 'hayir';
    acDugme?.setAttribute('aria-expanded', String(acik));
    perdeTazele();
    document.documentElement.style.overflow = acik ? 'hidden' : '';
    if (acik) {
      oncekiOdak = document.activeElement as HTMLElement;
      odaklanabilirler()[0]?.focus();
    } else {
      oncekiOdak?.focus();
      oncekiOdak = null;
    }
  }

  cekmece?.addEventListener('keydown', (e) => {
    if (e.key !== 'Tab') return;
    const sira = odaklanabilirler();
    if (!sira.length) return;
    const [ilk] = sira;
    const son = sira[sira.length - 1];
    if (e.shiftKey && document.activeElement === ilk) {
      e.preventDefault();
      son.focus();
    } else if (!e.shiftKey && document.activeElement === son) {
      e.preventDefault();
      ilk.focus();
    }
  });

  // Perdeye dokunmak açık olan her şeyi kapatıyor.
  perde?.addEventListener('click', () => {
    megaAyarla(null);
    cekmeceAyarla(false);
  });

  acDugme?.addEventListener('click', () => cekmeceAyarla(true));
  document.querySelector('[data-cekmece-kapat]')?.addEventListener('click', () => cekmeceAyarla(false));
  cekmece?.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => cekmeceAyarla(false)));
</script>
