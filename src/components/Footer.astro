---
import { SITE, KONULAR } from '../site.js';
import { DERLEME } from '../derleme.js';
const yil = new Date().getFullYear();
---

<footer class="site-alt">
  <div class="kap">
    <div class="marka">
      <span class="logo">{SITE.name}</span>
      <span>
        {SITE.author.name} · {SITE.author.jobTitle}. Üretim ortamında denenmiş BT rehberleri.
      </span>
    </div>
    <div class="alt-sutunlar">
      <div class="alt-sutun">
        <b>Konular</b>
        {KONULAR.slice(0, 4).map((k) => <a href={`/konu/${k.slug}`}>{k.ad}</a>)}
      </div>
      <div class="alt-sutun">
        <b>İçerik</b>
        <a href="/rehberler">Tüm rehberler</a>
        <a href="/hizli-cozumler">Hızlı Çözümler</a>
        <a href="/komutlar">Komut kütüphanesi</a>
        <a href="/ipuclari">Hızlı ipuçları</a>
        <a href="/portfolyo">Portfolyo</a>
        <a href="/rss.xml">RSS</a>
      </div>
      <div class="alt-sutun">
        <b>Site</b>
        <a href="/hakkimda">Hakkımda</a>
        <a href="/ozgecmis">Özgeçmiş</a>
        <a href="/hakkimda#iletisim">İletişim</a>
        <a href="/sitemap-index.xml">Site haritası</a>
      </div>
    </div>
  </div>
  <div class="alt-cizgi">
    <div class="kap">
      <span>© {yil} {SITE.name} · Reklam yok, sponsor yok.</span>
      <span class="derleme" title={DERLEME.tamSurum ? `Commit ${DERLEME.tamSurum}` : 'Yerel derleme'}>
        Derleme <b>{DERLEME.surum}</b> ·
        <time datetime={DERLEME.zamanISO}>{DERLEME.zamanMetin}</time>
      </span>
    </div>
  </div>
</footer>
