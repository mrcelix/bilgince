---
import { trKisaTarih } from '../site.js';

interface Props {
  href: string;
  baslik: string;
  ozet: string;
  tarih: Date;
  sure: number;
  etiketler?: string[];
}
const { href, baslik, ozet, tarih, sure, etiketler = [] } = Astro.props;
---

<article class="satir">
  <span class="tarih">{trKisaTarih(tarih)}</span>
  <div>
    <h3><a href={href}>{baslik}</a></h3>
    <p>{ozet}</p>
    {
      etiketler.length > 0 && (
        <span class="yigin" style="margin-top:9px">
          {etiketler.map((e) => (
            <a href={`/etiket/${e}`}>{e}</a>
          ))}
        </span>
      )
    }
  </div>
  <span class="sure">{sure} dk</span>
</article>
